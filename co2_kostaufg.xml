        </record>

        <menuitem
            parent="menu_real_estate_configuration"
            sequence="45"
            action="act_co2_emission_share"
            id="menu_co2_emission_share"/>

        <!-- Default 10-tier distribution model, CO2KostAufG Anlage 1
             (residential rented buildings without separate sub-metering
             by usage). emission_limit is the exclusive upper bound of
             each tier (kg CO2/m² per year); the last tier's own limit is
             a placeholder - it is always treated as the open-ended
             "52 kg/m² and above" tier, see Co2EmissionShare.get_share. -->
        <record model="real_estate.co2_emission_share" id="co2_emission_share_tier_1">
            <field name="sequence" eval="10"/>
            <field name="emission_limit" eval="Decimal('12.00')"/>
            <field name="tenant_share" eval="Decimal('100.00')"/>
            <field name="landlord_share" eval="Decimal('0.00')"/>
        </record>
        <record model="real_estate.co2_emission_share" id="co2_emission_share_tier_2">
            <field name="sequence" eval="20"/>
            <field name="emission_limit" eval="Decimal('17.00')"/>
            <field name="tenant_share" eval="Decimal('90.00')"/>
            <field name="landlord_share" eval="Decimal('10.00')"/>
        </record>
        <record model="real_estate.co2_emission_share" id="co2_emission_share_tier_3">
