<?xml version="1.0"?>
<tryton>
    <data>
        <!-- Price index series and monthly values (index rent, § 557b BGB) -->
        <record model="ir.ui.view" id="price_index_view_list">
            <field name="model">real_estate.price_index</field>
            <field name="type">tree</field>
            <field name="name">price_index_list</field>
        </record>
        <record model="ir.ui.view" id="price_index_view_form">
            <field name="model">real_estate.price_index</field>
            <field name="type">form</field>
            <field name="name">price_index_form</field>
        </record>
        <record model="ir.ui.view" id="price_index_value_view_list">
            <field name="model">real_estate.price_index.value</field>
            <field name="type">tree</field>
            <field name="name">price_index_value_list</field>
        </record>
        <record model="ir.ui.view" id="price_index_value_view_list_inline">
            <field name="model">real_estate.price_index.value</field>
            <field name="type">tree</field>
            <field name="name">price_index_value_list_inline</field>
        </record>
        <record model="ir.ui.view" id="price_index_value_view_form">
            <field name="model">real_estate.price_index.value</field>
            <field name="type">form</field>
            <field name="name">price_index_value_form</field>
        </record>
        <record model="ir.ui.view" id="price_index_value_context_view_form">
            <field name="model">real_estate.price_index.value.context</field>
            <field name="type">form</field>
            <field name="name">price_index_value_context_form</field>
        </record>

        <record model="ir.action.act_window" id="act_price_index">
            <field name="name">Price Indices</field>
            <field name="res_model">real_estate.price_index</field>
        </record>
        <record model="ir.action.act_window.view" id="act_price_index_view1">
            <field name="sequence" eval="10"/>
            <field name="view" ref="price_index_view_list"/>
            <field name="act_window" ref="act_price_index"/>
        </record>
        <record model="ir.action.act_window.view" id="act_price_index_view2">
            <field name="sequence" eval="20"/>
            <field name="view" ref="price_index_view_form"/>
            <field name="act_window" ref="act_price_index"/>
        </record>
        <menuitem
            parent="menu_real_estate_configuration"
            sequence="40"
            action="act_price_index"
            id="menu_price_index"/>

        <record model="ir.action.act_window" id="act_price_index_value">
            <field name="name">Price Index Values</field>
            <field name="res_model">real_estate.price_index.value</field>
            <field name="context_model">real_estate.price_index.value.context</field>
            <field name="context_domain"
                eval="[If(Eval('price_index', None), [('index', '=', Eval('price_index', None))], []), If(Eval('base_year', None), [('base_year', '=', Eval('base_year', None))], [])]"
                pyson="1"/>
        </record>
        <record model="ir.action.act_window.view" id="act_price_index_value_view1">
            <field name="sequence" eval="10"/>
            <field name="view" ref="price_index_value_view_list"/>
            <field name="act_window" ref="act_price_index_value"/>
        </record>
        <record model="ir.action.act_window.view" id="act_price_index_value_view2">
            <field name="sequence" eval="20"/>
            <field name="view" ref="price_index_value_view_form"/>
            <field name="act_window" ref="act_price_index_value"/>
        </record>
        <menuitem
            parent="menu_price_index"
            sequence="10"
            action="act_price_index_value"
            id="menu_price_index_value"/>

        <record model="ir.model.button" id="price_index_fetch_button">
            <field name="model">real_estate.price_index</field>
            <field name="name">fetch</field>
            <field name="string">Fetch Values</field>
        </record>
        <record model="ir.model.button-res.group" id="price_index_fetch_button_group_admin">
            <field name="button" ref="price_index_fetch_button"/>
            <field name="group" ref="group_real_estate_admin"/>
        </record>
        <record model="ir.model.button" id="price_index_fetch_full_button">
            <field name="model">real_estate.price_index</field>
            <field name="name">fetch_full</field>
            <field name="string">Fetch from Base Year</field>
        </record>
        <record model="ir.model.button-res.group" id="price_index_fetch_full_button_group_admin">
            <field name="button" ref="price_index_fetch_full_button"/>
            <field name="group" ref="group_real_estate_admin"/>
        </record>

        <!-- CSV import wizard (administration only) -->
        <record model="ir.ui.view" id="price_index_import_start_view_form">
            <field name="model">real_estate.price_index.import.start</field>
            <field name="type">form</field>
            <field name="name">price_index_import_start_form</field>
        </record>
        <record model="ir.ui.view" id="price_index_import_preview_view_form">
