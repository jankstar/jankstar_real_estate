    </data>

    <data noupdate="1">
        <!-- Default series: VPI Germany (the only index allowed for
             residential index rents, § 557b BGB) and HVPI as manual
             template for commercial contracts (Preisklauselgesetz) -->
        <record model="real_estate.price_index" id="price_index_vpi_de">
            <field name="code">VPI-DE</field>
            <field name="name">Consumer Price Index Germany (VPI)</field>
            <field name="source">destatis_genesis</field>
            <field name="genesis_table">61111-0002</field>
            <field name="base_year" eval="2020"/>
            <field name="residential_allowed" eval="True"/>
        </record>
        <record model="real_estate.price_index" id="price_index_hvpi_de">
            <field name="code">HVPI-DE</field>
            <field name="name">Harmonised Index of Consumer Prices Germany (HICP)</field>
            <field name="source">manual</field>
            <field name="base_year" eval="2015"/>
            <field name="residential_allowed" eval="False"/>
        </record>
    </data>
</tryton>
