        </record>
        <record model="ir.model.access" id="access_price_index_default">
            <field name="model">real_estate.price_index</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_price_index_value_object">
            <field name="model">real_estate.price_index.value</field>
            <field name="group" ref="group_real_estate_object"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_price_index_value_contract">
            <field name="model">real_estate.price_index.value</field>
            <field name="group" ref="group_real_estate_contract"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_price_index_value_billing">
