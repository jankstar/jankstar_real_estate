            <field name="type">form</field>
            <field name="name">price_index_import_preview_form</field>
        </record>
        <record model="ir.ui.view" id="price_index_import_result_view_form">
            <field name="model">real_estate.price_index.import.result</field>
            <field name="type">form</field>
            <field name="name">price_index_import_result_form</field>
        </record>
        <record model="ir.action.wizard" id="wizard_price_index_import">
            <field name="name">Import Index Values</field>
            <field name="wiz_name">real_estate.price_index.import</field>
        </record>
        <record model="ir.action-res.group" id="wizard_price_index_import_group_admin">
            <field name="action" ref="wizard_price_index_import"/>
            <field name="group" ref="group_real_estate_admin"/>
        </record>
        <record model="ir.action.keyword" id="wizard_price_index_import_keyword">
            <field name="keyword">form_action</field>
            <field name="model">real_estate.price_index,-1</field>
            <field name="action" ref="wizard_price_index_import"/>
        </record>
        <menuitem
            parent="menu_price_index"
            sequence="20"
            action="wizard_price_index_import"
            id="menu_price_index_import"/>

        <!-- Access: read for the functional groups, maintenance by the
