msgid "Base year of the values in the file."
msgstr "Basisjahr der Werte in der Datei."

msgctxt "field:real_estate.price_index.import.start,final:"
msgid "Final Values"
msgstr "Endgültige Werte"

msgctxt "help:real_estate.price_index.import.start,final:"
msgid ""
"Mark the imported values as final (only final values are used for rent "
"adjustments)."
msgstr ""
"Importierte Werte als endgültig kennzeichnen (nur endgültige Werte werden für"
" Mietanpassungen verwendet)."

msgctxt "field:real_estate.price_index.import.start,file:"
msgid "File"
msgstr "Datei"

msgctxt "help:real_estate.price_index.import.start,file:"
msgid ""
"CSV file with the columns 'Month;Value' (month as YYYY-MM or MM.YYYY) or "
"'Year;Month name;Value' (GENESIS-Online table download). Other rows are "
"ignored."
msgstr ""
"CSV-Datei mit den Spalten 'Monat;Wert' (Monat als JJJJ-MM oder MM.JJJJ) oder "
"'Jahr;Monatsname;Wert' (Tabellen-Download aus GENESIS-Online). Andere Zeilen "
"werden ignoriert."

