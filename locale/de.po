msgstr ""
"„%(name)s“: Mieteranteil und Vermieteranteil müssen zusammen 100%% ergeben."

msgctxt "model:ir.message,text:msg_contract_auto_terminated"
msgid "Automatic: contractual end date reached."
msgstr "Automatisch: Vertragsende erreicht."

msgctxt "model:ir.message,text:msg_contract_item_object_unique"
msgid "This object is already assigned to this contract item."
msgstr "Dieses Objekt ist dieser Vertragsposition bereits zugeordnet."

msgctxt "model:ir.message,text:msg_contract_party_role_c_type_unique"
msgid "This contract type is already assigned to this party role."
msgstr "Diese Vertragsart ist dieser Partnerrolle bereits zugeordnet."

msgctxt "model:ir.message,text:msg_contract_party_unique"
msgid ""
"This party, role and valid-from date combination already exists for this "
"contract."
msgstr ""
"Diese Kombination aus Partner, Rolle und Gültig-ab-Datum existiert für "
"diesen Vertrag bereits."

msgctxt "model:ir.message,text:msg_contract_party_role_mandatory_missing"
msgid ""
"Contract \"%(contract)s\" does not have the mandatory role \"%(role)s\" "
"assigned without gaps for its whole validity period."
msgstr ""
"Vertrag \"%(contract)s\" hat die Muss-Rolle \"%(role)s\" nicht lückenlos "
"über die gesamte Vertragsgültigkeit zugeordnet."

msgctxt "model:ir.message,text:msg_contract_party_role_only_once_violated"
msgid ""
"Contract \"%(contract)s\" has more than one party assigned to role "
"\"%(role)s\" at the same time - this role may only be assigned once at a "
"time."
msgstr ""
"Vertrag \"%(contract)s\" hat mehr als einen Partner gleichzeitig mit der "
"Rolle \"%(role)s\" zugeordnet - diese Rolle darf zu einem Zeitpunkt nur "
"einmal vergeben sein."

msgctxt "model:ir.message,text:msg_change_partner_date_out_of_range"
msgid ""
"The change date for contract \"%(contract)s\" must be between its start "
"date and its (effective) end date (%(start_date)s - %(end_date)s)."
msgstr ""
"Das Datum zum Wechsel für Vertrag \"%(contract)s\" muss zwischen "
"Vertragsbeginn und (effektivem) Vertragsende liegen (%(start_date)s - "
"%(end_date)s)."

msgctxt "model:ir.message,text:msg_change_partner_same_party"
msgid ""
"Cannot change the partner of contract \"%(contract)s\": the new partner "
"must be different from the current one."
msgstr ""
"Partnerwechsel für Vertrag \"%(contract)s\" nicht möglich: Der neue Partner "
"muss sich vom aktuellen Partner unterscheiden."

msgctxt "model:ir.message,text:msg_contract_partner_change_draft_invoices"
msgid ""
"Warning: contract \"%(contract)s\" still has %(count)s draft invoice(s) "
"under partner \"%(party)s\". These will NOT be rebooked to the new "
"partner (only posted, still open items are). Continue anyway?"
msgstr ""
"Achtung: Vertrag \"%(contract)s\" hat noch %(count)s Beleg(e) im Status "
"Entwurf unter Partner \"%(party)s\". Diese werden NICHT auf den neuen "
"Partner umgebucht (nur gebuchte, noch offene Posten werden umgebucht). "
"Trotzdem fortfahren?"

msgctxt "model:ir.message,text:msg_contract_partner_changed_has_bookings"
msgid ""
"Warning: contract \"%(contract)s\" already has booked entries under "
"partner \"%(party)s\" - the contractual partner is about to change. "
"Continue?"
msgstr ""
"Achtung: Vertrag \"%(contract)s\" hat bereits gebuchte Posten unter "
"Partner \"%(party)s\" - der Vertragspartner wird geändert. Fortfahren?"

msgctxt "model:ir.message,text:msg_contract_party_delete_has_bookings"
msgid ""
"Cannot remove party \"%(party)s\" from contract \"%(contract)s\": it "
"still has booked entries in the cash flow, and no other party "
"assignment row for it remains on this contract."
msgstr ""
"Partner \"%(party)s\" kann nicht von Vertrag \"%(contract)s\" entfernt "
"werden: Es gibt noch gebuchte Posten im Finanzstrom für diesen Partner, "
"und es bliebe keine andere Partnerzuordnung für ihn an diesem Vertrag "
"übrig."

msgctxt "model:ir.message,text:msg_contract_term_type_c_type_unique"
msgid "This contract type is already assigned to this term type."
msgstr "Diese Vertragsart ist dieser Konditionsart bereits zugeordnet."

#, python-format
msgctxt ""
"model:ir.message,text:msg_contract_termination_confirmation_not_terminated"
msgid ""
"\"%(name)s\": a termination confirmation can only be printed for a contract "
"that has been terminated."
msgstr ""
"„%(name)s“: eine Kündigungsbestätigung kann nur für einen gekündigten "
"Vertrag gedruckt werden."

#, python-format
msgctxt "model:ir.message,text:msg_contract_unlimited_with_end_date"
msgid ""
"\"%(name)s\": an unlimited contract must not have an end date. Either clear "
"the end date or unset \"Unlimited Contract\"."
msgstr ""
"„%(name)s“: ein unbefristeter Vertrag darf kein Enddatum haben. Entweder das"
" Enddatum löschen oder „Unbefristeter Vertrag“ deaktivieren."

#, python-format
msgctxt "model:ir.message,text:msg_cron_task_invalid_day"
msgid "\"%(name)s\": \"Run on Day of Month\" must be between 1 and 31."
msgstr "\"%(name)s\": \"Ausführungstag im Monat\" muss zwischen 1 und 31 liegen."

#, python-format
msgctxt "model:ir.message,text:msg_cron_task_invalid_interval_months"
msgid "\"%(name)s\": \"Interval (Months)\" must be at least 1."
msgstr "\"%(name)s\": \"Intervall (Monate)\" muss mindestens 1 sein."

#, python-format
msgctxt "model:ir.message,text:msg_cron_task_no_schedule"
msgid ""
"\"%(name)s\": set one of \"Interval (Days)\", \"Interval (Months)\", or "
"\"Run on Day of Month\"."
msgstr ""
"\"%(name)s\": Bitte eines der Felder \"Intervall (Tage)\", \"Intervall "
"(Monate)\" oder \"Ausführungstag im Monat\" setzen."

msgctxt "model:ir.message,text:msg_cron_task_unique"
msgid ""
"This task is already configured for this real estate accounting "
"configuration."
msgstr ""
"Diese Aufgabe ist für diese RE-Rechnungswesen-Konfiguration bereits "
"eingerichtet."

#, python-format
msgctxt "model:ir.message,text:msg_cron_task_valid_until_before_from"
msgid "\"%(name)s\": \"Valid Until\" must not be before \"Valid From\"."
msgstr "\"%(name)s\": \"Letzter Aufruf am (Ende)\" darf nicht vor \"Gültig ab\" liegen."

#, python-format
msgctxt "model:ir.message,text:msg_degree_day_not_implemented"
msgid ""
