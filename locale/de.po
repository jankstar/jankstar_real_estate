msgid "Source"
msgstr "Quelle"

msgctxt "help:real_estate.price_index,source:"
msgid ""
"Origin of the values. The automatic GENESIS-Online import is not available "
"yet - values are imported by CSV or entered manually."
msgstr ""
"Herkunft der Werte. Der automatische Abruf über GENESIS-Online ist noch nicht"
" verfügbar - Werte werden per CSV importiert oder manuell erfasst."

msgctxt "selection:real_estate.price_index,source:"
msgid "Destatis GENESIS-Online"
msgstr "Destatis GENESIS-Online"

msgctxt "selection:real_estate.price_index,source:"
msgid "Manual"
msgstr "Manuell"

