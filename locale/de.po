msgctxt "model:ir.model.button,help:rent_survey_version_new_version_button"
msgid "Copy the version with all data (codes kept) for a new validity."
msgstr ""
"Version mit allen Daten (Codes bleiben erhalten) für eine neue Gültigkeit "
"kopieren."

