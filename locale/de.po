msgctxt "model:ir.message,text:msg_inspection_access_attempts"
msgid ""
"The inspection \"%(inspection)s\" has %(count)s lines not inspected after "
"fewer access attempts than required."
msgstr ""
"Der Prüfvorgang \"%(inspection)s\" hat %(count)s nicht geprüfte Positionen "
"nach weniger Zugangsversuchen als vorgesehen."

msgctxt "model:ir.message,text:msg_inspection_approval_group"
msgid ""
"Only members of the group \"%(group)s\" can approve the inspection "
"\"%(inspection)s\"."
msgstr ""
"Nur Mitglieder der Gruppe \"%(group)s\" können den Prüfvorgang "
"\"%(inspection)s\" freigeben."

msgctxt "model:ir.message,text:msg_inspection_cancel_reason"
msgid ""
"Please enter a cancel reason for the inspection \"%(inspection)s\" (tab "
"\"Summary\")."
msgstr ""
"Bitte für den Prüfvorgang \"%(inspection)s\" einen Abbruchgrund erfassen "
"(Reiter \"Zusammenfassung\")."

msgctxt "model:ir.message,text:msg_inspection_contractor"
msgid ""
"The inspection \"%(inspection)s\" cannot be done: the inspection type "
"requires the contractor and an external report number or an attachment."
msgstr ""
"Der Prüfvorgang \"%(inspection)s\" kann nicht abgeschlossen werden: Die "
"Prüfart verlangt den Dienstleister und eine externe Berichtsnummer oder einen"
" Anhang."

msgctxt "model:ir.message,text:msg_inspection_delete"
msgid ""
"The inspection \"%(inspection)s\" can only be deleted in state draft or "
"cancelled."
msgstr ""
"Der Prüfvorgang \"%(inspection)s\" kann nur im Status Entwurf oder "
"Abgebrochen gelöscht werden."

msgctxt "model:ir.message,text:msg_inspection_locked"
msgid ""
"The inspection \"%(inspection)s\" is approved and cannot be changed - create "
"a new inspection that corrects it."
msgstr ""
"Der Prüfvorgang \"%(inspection)s\" ist freigegeben und kann nicht geändert "
"werden - bitte einen neuen Prüfvorgang anlegen, der ihn korrigiert."

msgctxt "model:ir.message,text:msg_inspection_mandatory"
msgid ""
"The inspection \"%(inspection)s\" cannot be done: mandatory check items are "
"not answered (%(items)s)."
msgstr ""
"Der Prüfvorgang \"%(inspection)s\" kann nicht abgeschlossen werden: Pflicht-"
"Prüfpunkte sind nicht beantwortet (%(items)s)."

msgctxt "model:ir.message,text:msg_inspection_not_inspected_reason"
msgid ""
"The inspection \"%(inspection)s\" cannot be done: lines not inspected need a "
"reason in the remarks (%(lines)s)."
msgstr ""
"Der Prüfvorgang \"%(inspection)s\" kann nicht abgeschlossen werden: Nicht "
"geprüfte Positionen brauchen einen Grund in den Bemerkungen (%(lines)s)."

msgctxt "model:ir.message,text:msg_inspection_notice_days"
msgid ""
"The inspection \"%(inspection)s\" is planned less than %(days)s days from "
"today - the tenant notice period may not be kept."
msgstr ""
"Der Prüfvorgang \"%(inspection)s\" ist in weniger als %(days)s Tagen geplant "
"- die Ankündigungsfrist für die Mieter wird möglicherweise nicht eingehalten."

msgctxt "model:ir.message,text:msg_inspection_photo"
msgid ""
"The inspection \"%(inspection)s\" cannot be done: check items answered \"not "
"OK\" need a photo (attachment) (%(items)s)."
msgstr ""
"Der Prüfvorgang \"%(inspection)s\" kann nicht abgeschlossen werden: "
"Prüfpunkte mit \"nicht i. O.\" brauchen ein Foto (Anhang) (%(items)s)."

msgctxt "model:ir.message,text:msg_inspection_plan_open"
msgid ""
"The inspection plan \"%(plan)s\" already has an open inspection "
"\"%(inspection)s\"."
msgstr ""
"Der Prüfplan \"%(plan)s\" hat bereits einen offenen Prüfvorgang "
"\"%(inspection)s\"."

msgctxt "model:ir.message,text:msg_inspection_planned_date"
msgid "The inspection \"%(inspection)s\" needs a planned date to be scheduled."
msgstr ""
"Für das Terminieren braucht der Prüfvorgang \"%(inspection)s\" ein geplantes "
"Datum."

