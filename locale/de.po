msgid "Operation Costs Plan"
msgstr "Betriebskostenplan"

msgctxt "selection:real_estate.contract.term.type,adjustment_procedures:"
msgid "Free Adjustment"
msgstr "Freie Anpassung"

msgctxt "field:real_estate.contract.term.type,adjustment_procedures:"
msgid "Allowed Adjustment Procedures"
msgstr "Zulässige Anpassungsverfahren"

msgctxt "help:real_estate.contract.term.type,adjustment_procedures:"
msgid ""
"Rent adjustment procedures allowed for contract terms of this type. Empty = "
"terms of this type cannot be adjusted (e.g. deposit)."
msgstr ""
"Für Vertragskonditionen dieser Art zulässige Mietanpassungsverfahren. Leer = "
"Konditionen dieser Art sind nicht anpassbar (z. B. Kaution)."

msgctxt "view:real_estate.contract.term.type:"
msgid "Rent Adjustment"
msgstr "Mietanpassung"

msgctxt "model:ir.message,text:msg_term_type_procedures_one_time"
msgid ""
"Term type \"%(term_type)s\": one-time terms cannot have adjustment "
"procedures."
msgstr ""
"Konditionsart „%(term_type)s“: Einmalige Konditionen können keine "
"Anpassungsverfahren haben."

msgctxt "model:ir.message,text:msg_term_type_procedures_need_oc"
msgid ""
"Term type \"%(term_type)s\": the procedures %(procedures)s are only allowed "
"with an operating cost processing."
msgstr ""
"Konditionsart „%(term_type)s“: Die Verfahren %(procedures)s sind nur mit "
"einer Betriebskosten-Verarbeitung zulässig."

msgctxt "model:ir.message,text:msg_term_type_procedures_without_oc"
msgid ""
"Term type \"%(term_type)s\": the procedures %(procedures)s are only allowed "
"without operating cost processing."
msgstr ""
"Konditionsart „%(term_type)s“: Die Verfahren %(procedures)s sind nur ohne "
"Betriebskosten-Verarbeitung zulässig."

msgctxt "model:ir.message,text:msg_term_split_before_start"
msgid ""
"Term \"%(term)s\" cannot be split on %(date)s: the date must be after its "
"start (%(valid_from)s)."
msgstr ""
"Kondition „%(term)s“ kann nicht zum %(date)s geteilt werden: Das Datum muss "
"nach ihrem Beginn (%(valid_from)s) liegen."

msgctxt "model:ir.message,text:msg_term_split_after_end"
msgid ""
"Term \"%(term)s\" cannot be split on %(date)s: the term ends on %(valid_to)s."
msgstr ""
"Kondition „%(term)s“ kann nicht zum %(date)s geteilt werden: Die Kondition "
"endet am %(valid_to)s."

msgctxt "model:ir.message,text:msg_term_split_booked"
msgid ""
"Term \"%(term)s\" cannot be split on %(date)s: it is booked up to "
"%(booked_to)s. Booked periods are not changed - cancel the period booking "
"first."
msgstr ""
"Kondition „%(term)s“ kann nicht zum %(date)s geteilt werden: Sie ist bis "
"%(booked_to)s gebucht. Gebuchte Zeiträume werden nicht geändert – zuerst die "
"periodische Buchung stornieren."

msgctxt "model:ir.message,text:msg_term_split_follow_up"
msgid ""
"Term \"%(term)s\" cannot be split on %(date)s: the follow-up term "
"\"%(follow_up)s\" of the same type and item already starts on or after this "
"date."
msgstr ""
"Kondition „%(term)s“ kann nicht zum %(date)s geteilt werden: Die "
"Folgekondition „%(follow_up)s“ gleicher Art und Position beginnt bereits an "
"oder nach diesem Datum."

