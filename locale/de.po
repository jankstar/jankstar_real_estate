msgctxt "model:ir.message,text:msg_index_adjustment_cap_changed"
msgid ""
"The adjustment \"%(adjustment)s\" cannot be executed: with the cap rule on "
"the actual receipt date only %(allowed)s are allowed, but %(declared)s were "
"declared (I11) - a new declaration is required."
msgstr ""
"Der Vorgang \"%(adjustment)s\" kann nicht ausgeführt werden: Mit der "
"Kappungsregel zum tatsächlichen Zugangsdatum sind nur %(allowed)s zulässig, "
"erklärt wurden %(declared)s (I11) - eine neue Erklärung ist erforderlich."

msgctxt "model:ir.message,text:msg_index_adjustment_log"
msgid ""
"Index rent adjusted: %(index)s %(month_old)s %(value_old)s -> %(month_new)s "
"%(value_new)s, change %(change)s %%, applied %(applied)s %% (cap rule: "
"%(cap)s); rent %(amount_old)s -> %(amount_new)s from %(valid_from)s; receipt "
"%(receipt)s, dispatch %(dispatch)s."
msgstr ""
"Indexmiete angepasst: %(index)s %(month_old)s %(value_old)s -> %(month_new)s "
"%(value_new)s, Veränderung %(change)s %%, angerechnet %(applied)s %% "
"(Kappungsregel: %(cap)s); Miete %(amount_old)s -> %(amount_new)s ab "
"%(valid_from)s; Zugang %(receipt)s, Versand %(dispatch)s."

