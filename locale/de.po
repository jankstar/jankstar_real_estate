msgid "Agreements"
msgstr "Vereinbarungen"

msgctxt "model:ir.message,text:msg_rent_adjustment_delete_draft"
msgid "Rent adjustment \"%(rent_adjustment)s\" can only be deleted in state draft."
msgstr ""
"Mietanpassung „%(rent_adjustment)s“ kann nur im Status Entwurf gelöscht "
"werden."

msgctxt "model:ir.message,text:msg_rent_adjustment_term_contract"
msgid "Term \"%(term)s\" does not belong to contract \"%(contract)s\"."
msgstr "Kondition „%(term)s“ gehört nicht zum Vertrag „%(contract)s“."

msgctxt "model:ir.message,text:msg_rent_adjustment_contract_type"
msgid ""
"The procedure \"%(procedure)s\" is not allowed for the contract type "
"\"%(c_type)s\"."
msgstr ""
"Das Verfahren „%(procedure)s“ ist für die Vertragsart „%(c_type)s“ nicht "
"zulässig."

msgctxt "model:ir.message,text:msg_rent_adjustment_term_type"
msgid ""
"The procedure \"%(procedure)s\" is not allowed for the term type "
"\"%(term_type)s\"."
msgstr ""
"Das Verfahren „%(procedure)s“ ist für die Konditionsart „%(term_type)s“ nicht"
" zulässig."

msgctxt "model:ir.message,text:msg_rent_adjustment_agreed_exclusive"
msgid ""
"Term \"%(term)s\" already has the agreed rent adjustment \"%(other)s\" - a "
"term can only have one graduated or index rent (§§ 557a, 557b BGB)."
msgstr ""
"Kondition „%(term)s“ hat bereits die vereinbarte Mietanpassung „%(other)s“ – "
"eine Kondition kann nur eine Staffel- oder Indexmiete haben (§§ 557a, 557b "
"BGB)."

msgctxt "model:ir.message,text:msg_graduated_contract_state"
msgid ""
"Graduated rent \"%(rent_adjustment)s\": only possible for a draft or running "
"contract without termination (G09)."
msgstr ""
"Staffelmiete „%(rent_adjustment)s“: nur bei einem Vertrag im Status Entwurf "
"oder Aktiv ohne Kündigung möglich (G09)."

msgctxt "model:ir.message,text:msg_graduated_measurement"
msgid ""
"Graduated rent \"%(rent_adjustment)s\": the base term has to be an absolute "
"amount - its term type \"%(term_type)s\" has a measurement type (G15)."
msgstr ""
"Staffelmiete „%(rent_adjustment)s“: Die Bezugskondition muss ein absoluter "
"Betrag sein – ihre Konditionsart „%(term_type)s“ hat eine Bemessung (G15)."

msgctxt "model:ir.message,text:msg_graduated_rhythm"
msgid ""
"Graduated rent \"%(rent_adjustment)s\": the rhythm has to be at least 12 "
"months (§ 557a para. 2 BGB, G02)."
msgstr ""
"Staffelmiete „%(rent_adjustment)s“: Der Rhythmus muss mindestens 12 Monate "
"betragen (§ 557a Abs. 2 BGB, G02)."

msgctxt "model:ir.message,text:msg_graduated_step_count"
msgid ""
"Graduated rent \"%(rent_adjustment)s\": at least one step is required (G03)."
msgstr ""
"Staffelmiete „%(rent_adjustment)s“: Es ist mindestens eine Staffel "
"erforderlich (G03)."

msgctxt "model:ir.message,text:msg_graduated_zero_quantity"
msgid "Graduated rent \"%(rent_adjustment)s\": the base term has no quantity."
msgstr ""
"Staffelmiete „%(rent_adjustment)s“: Die Bezugskondition hat keine Menge."

msgctxt "model:ir.message,text:msg_graduated_no_area"
msgid ""
"Graduated rent \"%(rent_adjustment)s\": no area found for the increase per "
"area - the term type needs an informative measurement type with a value for "
"the objects (G14)."
msgstr ""
"Staffelmiete „%(rent_adjustment)s“: Für die Erhöhung je Fläche wurde keine "
"Fläche gefunden – die Konditionsart braucht eine informative Bemessung mit "
"einem Wert für die Objekte (G14)."

msgctxt "model:ir.message,text:msg_graduated_increase"
msgid ""
"Graduated rent \"%(rent_adjustment)s\": the increase has to be positive and "
"at least 0.01 per step (G04)."
msgstr ""
"Staffelmiete „%(rent_adjustment)s“: Die Erhöhung muss positiv sein und je "
"Staffel mindestens 0,01 betragen (G04)."

msgctxt "model:ir.message,text:msg_graduated_term_booked"
msgid ""
"Graduated rent \"%(rent_adjustment)s\": the base term \"%(term)s\" is already"
" booked (last document date %(date)s) (G05)."
msgstr ""
"Staffelmiete „%(rent_adjustment)s“: Die Bezugskondition „%(term)s“ ist "
"bereits gebucht (letztes Belegdatum %(date)s) (G05)."

msgctxt "model:ir.message,text:msg_graduated_term_locked"
msgid ""
"Graduated rent \"%(rent_adjustment)s\": the base term is part of the "
"graduated rent \"%(other)s\" - only its last step can be the base of a "
"follow-up graduated rent (G08)."
msgstr ""
"Staffelmiete „%(rent_adjustment)s“: Die Bezugskondition gehört zur "
"Staffelmiete „%(other)s“ – nur deren letzte Staffel kann Bezugskondition "
"einer Anschlussstaffel sein (G08)."

msgctxt "model:ir.message,text:msg_graduated_follow_up"
msgid ""
"Graduated rent \"%(rent_adjustment)s\": the follow-up term \"%(follow_up)s\" "
"of the same type and item already exists (G06)."
msgstr ""
"Staffelmiete „%(rent_adjustment)s“: Die Folgekondition „%(follow_up)s“ "
"gleicher Art und Position existiert bereits (G06)."

msgctxt "model:ir.message,text:msg_graduated_too_many_steps"
msgid ""
"Graduated rent \"%(rent_adjustment)s\": the last step would start on "
"%(date)s, after the end of the term or contract (%(end)s) - at most %(max)s "
"steps are possible (G07)."
msgstr ""
"Staffelmiete „%(rent_adjustment)s“: Die letzte Staffel würde am %(date)s "
"beginnen, nach dem Ende der Kondition bzw. des Vertrags (%(end)s) – möglich "
"sind höchstens %(max)s Staffeln (G07)."

msgctxt "model:ir.message,text:msg_graduated_written_form"
msgid ""
"Graduated rent \"%(rent_adjustment)s\": a residential graduated rent has to "
"be agreed in writing - confirm \"Written Form\" (§ 557a para. 1 BGB, G10)."
msgstr ""
"Staffelmiete „%(rent_adjustment)s“: Eine Wohnraum-Staffelmiete muss "
"schriftlich vereinbart sein – bitte „Schriftform“ bestätigen (§ 557a Abs. 1 "
"BGB, G10)."

msgctxt "model:ir.message,text:msg_graduated_written_form_warning"
msgid ""
"Graduated rent \"%(rent_adjustment)s\": the written form is not confirmed "
"(G10)."
msgstr ""
"Staffelmiete „%(rent_adjustment)s“: Die Schriftform ist nicht bestätigt "
"(G10)."

msgctxt "model:ir.message,text:msg_graduated_waiver"
msgid ""
"Graduated rent \"%(rent_adjustment)s\": the termination waiver until %(date)s"
" exceeds 4 years after the agreement - the waiver is invalid beyond that (§ "
"557a para. 3 BGB, G11)."
msgstr ""
"Staffelmiete „%(rent_adjustment)s“: Der Kündigungsverzicht bis %(date)s liegt"
" mehr als 4 Jahre nach der Vereinbarung – darüber hinaus ist der Verzicht "
"unwirksam (§ 557a Abs. 3 BGB, G11)."

msgctxt "model:ir.message,text:msg_graduated_rounding"
msgid ""
"Graduated rent \"%(rent_adjustment)s\": with quantity %(quantity)s, quantity "
"× unit price deviates from the step amount by up to %(deviation)s (G12). A "
"quantity of 1 avoids this."
msgstr ""
"Staffelmiete „%(rent_adjustment)s“: Bei Menge %(quantity)s weicht Menge × "
"Einzelpreis um bis zu %(deviation)s vom Staffelbetrag ab (G12). Mit Menge 1 "
"tritt das nicht auf."

msgctxt "model:ir.message,text:msg_graduated_rhythm_mismatch"
msgid ""
"Graduated rent \"%(rent_adjustment)s\": the step starting on %(date)s does "
"not match the billing rhythm of the base term (G13)."
msgstr ""
"Staffelmiete „%(rent_adjustment)s“: Die Staffel ab %(date)s passt nicht zum "
"Abrechnungsrhythmus der Bezugskondition (G13)."

msgctxt "model:ir.message,text:msg_graduated_booked"
msgid ""
"Graduated rent \"%(rent_adjustment)s\" is already booked - reset is not "
"possible. Use \"Regenerate\" (only the steps not yet booked) or \"End "
"Graduated Rent\"."
msgstr ""
"Staffelmiete „%(rent_adjustment)s“ ist bereits gebucht – Zurücksetzen ist "
"nicht möglich. „Neu berechnen“ (nur die noch nicht gebuchten Staffeln) oder "
"„Staffel beenden“ verwenden."

msgctxt "model:ir.message,text:msg_graduated_follow_up_rent_adjustment"
msgid ""
"Graduated rent \"%(rent_adjustment)s\": the follow-up graduated rent "
"\"%(other)s\" is based on its last step - reset or delete that one first."
msgstr ""
"Staffelmiete „%(rent_adjustment)s“: Auf ihrer letzten Staffel setzt die "
"Anschlussstaffel „%(other)s“ auf – diese zuerst zurücksetzen oder löschen."

msgctxt "model:ir.message,text:msg_graduated_last_step_changed"
msgid ""
"Graduated rent \"%(rent_adjustment)s\": its last step \"%(term)s\" has been "
"changed (end date) - reset is not possible."
msgstr ""
"Staffelmiete „%(rent_adjustment)s“: Ihre letzte Staffel „%(term)s“ wurde "
"geändert (Enddatum) – Zurücksetzen ist nicht möglich."

msgctxt "model:ir.model.button,string:contract_rent_adjustment_generate_button"
msgid "Generate"
msgstr "Generieren"

msgctxt ""
"model:ir.model.button,string:contract_rent_adjustment_regenerate_button"
msgid "Regenerate"
msgstr "Neu berechnen"

msgctxt "model:ir.model.button,string:contract_rent_adjustment_reset_button"
msgid "Reset"
msgstr "Zurücksetzen"

msgctxt "model:ir.message,text:msg_term_graduated_locked"
msgid ""
"Term \"%(term)s\" is part of the graduated rent \"%(rent_adjustment)s\" and "
"cannot be changed (dates, type, item, rhythm, taxes). Use the graduated rent "
"(regenerate, reset) instead."
msgstr ""
"Kondition „%(term)s“ gehört zur Staffelmiete „%(rent_adjustment)s“ und kann "
"nicht geändert werden (Termine, Art, Position, Rhythmus, Steuern). Änderungen"
" erfolgen über die Staffelmiete (Neu berechnen, Zurücksetzen)."

msgctxt "model:ir.message,text:msg_term_graduated_delete"
msgid ""
"Term \"%(term)s\" is part of the graduated rent \"%(rent_adjustment)s\" and "
"can only be removed by resetting the graduated rent."
msgstr ""
"Kondition „%(term)s“ gehört zur Staffelmiete „%(rent_adjustment)s“ und kann "
"nur durch Zurücksetzen der Staffelmiete entfernt werden."

msgctxt "model:ir.message,text:msg_term_split_locked"
msgid "Term \"%(term)s\" is locked by a graduated rent and cannot be split."
msgstr ""
"Kondition „%(term)s“ ist durch eine Staffelmiete gesperrt und kann nicht "
"geteilt werden."

msgctxt "model:ir.message,text:msg_rent_adjustment_term_locked"
msgid ""
"Term \"%(term)s\" is locked by a graduated rent - no other rent adjustment is"
" possible during the graduated rent (§ 557a para. 2 BGB)."
msgstr ""
"Kondition „%(term)s“ ist durch eine Staffelmiete gesperrt – während der "
"Staffel ist keine andere Mietanpassung möglich (§ 557a Abs. 2 BGB)."

msgctxt "field:real_estate.contract.term,graduated_locked:"
msgid "Locked by Graduated Rent"
msgstr "Durch Staffelmiete gesperrt"

msgctxt "help:real_estate.contract.term,graduated_locked:"
msgid ""
"Base term or intermediate step of a generated graduated rent (or last step "
"carrying a follow-up graduated rent): dates, type, item, rhythm and taxes "
"cannot be changed and the term cannot be deleted or adjusted otherwise (§ "
"557a para. 2 BGB)."
msgstr ""
"Bezugskondition oder Zwischenstaffel einer generierten Staffelmiete (bzw. "
"letzte Staffel mit Anschlussstaffel): Termine, Art, Position, Rhythmus und "
"Steuern sind nicht änderbar, die Kondition kann weder gelöscht noch anders "
"angepasst werden (§ 557a Abs. 2 BGB)."

msgctxt "view:real_estate.contract.term:"
msgid ""
"Part of a graduated rent: dates, type, item, rhythm and taxes cannot be "
"changed."
msgstr ""
"Teil einer Staffelmiete: Termine, Art, Position, Rhythmus und Steuern sind "
"nicht änderbar."

msgctxt "model:ir.message,text:msg_graduated_rent_contract_change"
msgid ""
"Contract \"%(contract)s\" contains a graduated rent agreement dated "
"%(agreement_date)s (%(steps)s steps, %(first_date)s - %(last_date)s). The "
"graduated rent is part of the contract; the contract explicitly does not "
"provide for any change of the agreed amounts or dates. A change requires a "
"contract amendment agreed with the tenant. The graduated rent is booked up to"
" %(booked_to)s; the change only affects steps not yet booked, from "
"%(first_open_date)s. Continue?"
msgstr ""
"Vertrag „%(contract)s“ enthält eine Staffelmietvereinbarung vom "
"%(agreement_date)s (%(steps)s Staffeln, %(first_date)s – %(last_date)s). Die "
"Staffel ist Vertragsgegenstand; der Vertrag sieht ausdrücklich keine Änderung"
" der vereinbarten Beträge oder Termine vor. Eine Änderung setzt eine mit dem "
"Mieter vereinbarte Vertragsänderung (Nachtrag) voraus. Die Staffel ist bis "
"%(booked_to)s gebucht; die Änderung wirkt nur auf die noch nicht gebuchten "
"Staffeln ab %(first_open_date)s. Fortfahren?"

msgctxt "model:ir.message,text:msg_graduated_rent_contract_change_term"
msgid ""
"Contract \"%(contract)s\" contains a graduated rent agreement dated "
"%(agreement_date)s (%(steps)s steps, %(first_date)s - %(last_date)s). The "
"graduated rent is part of the contract; the contract explicitly does not "
"provide for any change of the agreed amounts or dates. A change requires a "
"contract amendment agreed with the tenant. Changed is step %(step)s from "
"%(valid_from)s. Continue?"
msgstr ""
"Vertrag „%(contract)s“ enthält eine Staffelmietvereinbarung vom "
"%(agreement_date)s (%(steps)s Staffeln, %(first_date)s – %(last_date)s). Die "
"Staffel ist Vertragsgegenstand; der Vertrag sieht ausdrücklich keine Änderung"
" der vereinbarten Beträge oder Termine vor. Eine Änderung setzt eine mit dem "
"Mieter vereinbarte Vertragsänderung (Nachtrag) voraus. Geändert wird Staffel "
"%(step)s ab %(valid_from)s. Fortfahren?"

msgctxt "model:ir.message,text:msg_graduated_booked_period"
msgid ""
"Graduated rent \"%(rent_adjustment)s\": the next step would start on "
"%(date)s, but the graduated rent is booked up to %(booked_to)s. Booked "
"periods are not changed - cancel the period booking first."
msgstr ""
"Staffelmiete „%(rent_adjustment)s“: Die nächste Staffel würde am %(date)s "
"beginnen, die Staffel ist aber bis %(booked_to)s gebucht. Gebuchte Zeiträume "
"werden nicht geändert – zuerst die periodische Buchung stornieren."

msgctxt "model:ir.message,text:msg_graduated_step_count_booked"
msgid ""
"Graduated rent \"%(rent_adjustment)s\": steps up to step %(step)s are booked "
"- the number of steps cannot be smaller."
msgstr ""
"Staffelmiete „%(rent_adjustment)s“: Die Staffeln bis Staffel %(step)s sind "
"gebucht – die Anzahl Staffeln kann nicht kleiner sein."

msgctxt "model:ir.message,text:msg_graduated_nothing_to_terminate"
msgid ""
"Graduated rent \"%(rent_adjustment)s\": all steps are booked - there is "
"nothing to end."
msgstr ""
"Staffelmiete „%(rent_adjustment)s“: Alle Staffeln sind gebucht – es gibt "
"nichts zu beenden."

msgctxt ""
"model:ir.model.button,string:contract_rent_adjustment_terminate_button"
msgid "End Graduated Rent"
msgstr "Staffel beenden"

msgctxt "field:real_estate.contract.rent_adjustment,generated_parameters:"
msgid "Generated Parameters"
msgstr "Generierte Parameter"

msgctxt "help:real_estate.contract.rent_adjustment,generated_parameters:"
msgid ""
"Parameters of the last generation - logged as the old parameters when the "
"graduated rent is changed after booking."
msgstr ""
"Parameter der letzten Generierung – werden bei einer Änderung nach Buchung "
"als alte Parameter protokolliert."

msgctxt "model:ir.message,text:msg_graduated_preview_increase"
msgid "(increase: %(increase)s)"
msgstr "(Erhöhung: %(increase)s)"

msgctxt "model:ir.message,text:msg_graduated_preview_increase_area"
msgid "(increase: %(increase)s, i.e. %(per_area)s %(currency)s / m²)"
msgstr "(Erhöhung: %(increase)s, das sind dann %(per_area)s %(currency)s / m²)"

msgctxt "model:ir.message,text:msg_graduated_preview_area"
msgid "(i.e. %(per_area)s %(currency)s / m²)"
msgstr "(das sind %(per_area)s %(currency)s / m²)"

msgctxt "field:real_estate.contract.rent_adjustment,predecessor:"
msgid "Previous Graduated Rent"
msgstr "Vorgängerstaffel"

msgctxt "help:real_estate.contract.rent_adjustment,predecessor:"
msgid ""
"Graduated rent whose last step is the base term of this one (follow-up "
"graduated rent)."
msgstr ""
"Staffelmiete, deren letzte Staffel die Bezugskondition dieser Staffel ist "
"(Anschlussstaffel)."

msgctxt "field:real_estate.contract.rent_adjustment,successor:"
msgid "Follow-up Graduated Rent"
msgstr "Anschlussstaffel"

msgctxt "help:real_estate.contract.rent_adjustment,successor:"
msgid "Graduated rent based on the last step of this one."
msgstr "Staffelmiete, die auf der letzten Staffel dieser Staffel aufsetzt."

msgctxt "field:real_estate.contract.term.type,separate_move:"
msgid "Separate Move"
msgstr "Eigene Buchung"

msgctxt "help:real_estate.contract.term.type,separate_move:"
msgid ""
"Post terms of this type in periodic postings as a separate move (own invoice "
"per contract and posting date) instead of together with the other terms of "
"the contract."
msgstr ""
"Konditionen dieser Art bei der periodischen Buchung als eigene Buchung "
"(eigene Rechnung je Vertrag und Buchungsdatum) statt zusammen mit den übrigen"
" Konditionen des Vertrags buchen."

msgctxt "field:real_estate.contract.term.type,move_description:"
msgid "Move Description"
msgstr "Buchungstext"

msgctxt "help:real_estate.contract.term.type,move_description:"
msgid ""
"Description of the separate move - empty = default description of the "
"contract type."
msgstr ""
"Buchungstext der eigenen Buchung - leer = Standardtext der Vertragsart."

msgctxt "view:real_estate.contract.term.type:"
msgid "Periodic Posting"
msgstr "Periodische Buchung"

msgctxt ""
"model:real_estate.contract.term.type,move_description:contract_term_type_rent_deposit"
msgid "Rental deposit"
msgstr "Mietkaution"

msgctxt "field:real_estate.contract.term,payment_term:"
msgid "Payment Term"
msgstr "Zahlungsbedingung"

msgctxt "help:real_estate.contract.term,payment_term:"
msgid ""
"Optional - payment term of the separate move of this term. Empty = payment "
"term of the contract, else of the party, else the default of the accounting "
"configuration."
msgstr ""
"Optional - Zahlungsbedingung der eigenen Buchung dieser Kondition. Leer = "
"Zahlungsbedingung des Vertrags, sonst der Partei, sonst der Standard aus der "
"Buchhaltungskonfiguration."

msgctxt "field:real_estate.contract.term,term_type_separate_move:"
msgid "Separate Move"
msgstr "Eigene Buchung"

msgctxt ""
"field:real_estate.contract.term.cash_flow.context,create_moves_run_id:"
msgid "Create Moves Run ID"
msgstr "ID Sollstellungslauf"

msgctxt "help:real_estate.contract.term.cash_flow.context,create_moves_run_id:"
msgid ""
"Only cash flow entries of this periodic posting run - the date range above is"
" ignored then. Newest runs first."
msgstr ""
"Nur Finanzstrom-Einträge dieses Sollstellungslaufs - der Datumsbereich oben "
"wird dann ignoriert. Neueste Läufe zuerst."

