#, python-format
msgctxt "model:ir.message,text:msg_base_object_invalid_type"
msgid "\"%(name)s\": invalid type '%(type)s'."
msgstr "„%(name)s“: ungültiger Typ '%(type)s'."

#, python-format
msgctxt "model:ir.message,text:msg_base_object_sequence_required"
msgid "\"%(name)s\": sequence is required."
msgstr "„%(name)s“: Sequenz ist erforderlich."

#, python-format
msgctxt "model:ir.message,text:msg_base_object_start_after_end"
msgid ""
"\"%(name)s\": start date (%(start_date)s) must not be after the end date "
"(%(end_date)s)."
msgstr ""
"„%(name)s“: Startdatum (%(start_date)s) darf nicht nach dem Enddatum "
"(%(end_date)s) liegen."

#, python-format
msgctxt "model:ir.message,text:msg_base_object_start_before_parent_start"
msgid ""
"\"%(name)s\": start date (%(start_date)s) must not be before the parent "
"start date (%(parent_start_date)s)."
msgstr ""
"„%(name)s“: Startdatum (%(start_date)s) darf nicht vor dem Startdatum des "
"übergeordneten Objekts (%(parent_start_date)s) liegen."

#, python-format
msgctxt "model:ir.message,text:msg_billing_collective_incomplete"
msgid ""
"Cannot bill property \"%(name)s\" for period %(next_date)s: collective billing requires all billing units to be selected. The following billing units are missing from the selection:\n"
"%(details)s\n"
"Add all billing units of this period to the selection or remove the billing unit filter."
msgstr ""

#, python-format
msgctxt "model:ir.message,text:msg_billing_unit_already_has_successor"
msgid ""
"Cannot duplicate \"%(name)s\": a billing unit for the next period already "
"exists (predecessor is set)."
msgstr ""

#, python-format
msgctxt "model:ir.message,text:msg_billing_unit_bved_assignment_conflict"
msgid ""
"\"%(name)s\": the following objects are covered by this billing unit but lie"
" outside the chosen BVED provider assignment's property/building: "
"%(details)s. Either choose a different assignment, or split this billing "
"unit so each part matches one assignment."
msgstr ""

#, python-format
msgctxt "model:ir.message,text:msg_billing_unit_bved_not_validated"
msgid ""
"Cannot set \"Ready for Billing\" for \"%(name)s\": the following settlement results are not yet BVED-validated:\n"
"%(details)s"
msgstr ""

#, python-format
msgctxt "model:ir.message,text:msg_billing_unit_chronological_order"
msgid ""
"The following billing units must be billed first (chronological order): "
"%(names)s"
msgstr ""
"Die folgenden Abrechnungseinheiten müssen zuerst abgerechnet werden "
"(chronologische Reihenfolge): %(names)s"

#, python-format
msgctxt "model:ir.message,text:msg_billing_unit_collective_required"
msgid ""
"Collective billing requires the following billing units to be processed "
"together: %(names)s"
msgstr ""
"Die Sammelabrechnung erfordert, dass die folgenden Abrechnungseinheiten "
"gemeinsam verarbeitet werden: %(names)s"

#, python-format
msgctxt ""
"model:ir.message,text:msg_billing_unit_compute_settlement_result_invalid_state"
msgid ""
"Cannot compute settlement result for \"%(name)s\": not allowed in state "
"'%(state)s'."
msgstr ""
"Abrechnungsergebnis für \"%(name)s\" kann nicht berechnet werden: im Status "
"'%(state)s' nicht erlaubt."

#, python-format
msgctxt "model:ir.message,text:msg_billing_unit_delete_not_draft"
msgid ""
"Cannot delete \"%(name)s\": deletion is only allowed in state 'Draft' "
"(current state: %(state)s)."
msgstr ""
"\"%(name)s\" kann nicht gelöscht werden: Löschen ist nur im Status 'Entwurf'"
" erlaubt (aktueller Status: %(state)s)."

#, python-format
msgctxt "model:ir.message,text:msg_billing_unit_draft_items"
msgid ""
"Cannot bill \"%(name)s\": unposted contract cash flow items exist in the "
"settlement period. Post all pending items (CreateMoves) before billing."
msgstr ""
"\"%(name)s\" kann nicht abgerechnet werden: Im Abrechnungszeitraum "
"existieren noch nicht gebuchte Sollstellungen. Bitte alle offenen Posten "
"zuerst buchen (Sollstellung erzeugen)."

#, python-format
msgctxt "model:ir.message,text:msg_billing_unit_has_errors"
msgid ""
"Cannot bill: settlement unit(s) have errors in \"%(names)s\". Fix all errors"
" before billing."
msgstr ""
"Abrechnung nicht möglich: Abrechnungseinheit(en) \"%(names)s\" enthalten "
"Fehler. Bitte alle Fehler beheben."

#, python-format
msgctxt "model:ir.message,text:msg_billing_unit_invoices_not_posted"
msgid ""
"Cannot bill \"%(name)s\": the following advance payment invoices are not yet posted:\n"
"%(details)s\n"
"Please post all invoices before billing."
msgstr ""

#, python-format
msgctxt "model:ir.message,text:msg_billing_unit_no_settlement_results"
msgid ""
"Cannot set \"Ready for Billing\" for \"%(name)s\": no approved settlement "
"results found. Please run \"Compute Settlement Results\" first."
msgstr ""

#, python-format
msgctxt "model:ir.message,text:msg_billing_unit_not_ready"
msgid ""
"Billing of \"%(name)s\" for period %(next_date)s aborted: the following billing units are not yet in state \"Ready for Billing\":\n"
"%(details)s\n"
"Either run \"Ready for Billing\" for each billing unit first, or bill individual billing units directly in the billing unit form."
msgstr ""

#, python-format
msgctxt "model:ir.message,text:msg_billing_unit_settlement_unit_errors"
msgid ""
"Cannot set \"Ready for Billing\" for \"%(name)s\": the following settlement units have errors:\n"
"%(details)s\n"
"Fix all errors before proceeding."
msgstr ""
"„Bereit zur Abrechnung“ kann für „%(name)s“ nicht festgelegt werden: Die "
"folgenden Abrechnungseinheiten weisen Fehler auf: %(details)s Beheben Sie "
"alle Fehler, bevor Sie fortfahren."

#, python-format
msgctxt "model:ir.message,text:msg_billing_unit_settlement_units_not_ready"
msgid ""
"Cannot set \"Ready for Billing\" for \"%(name)s\": the following settlement units have not reached state \"value_share\":\n"
"%(details)s\n"
"Run \"Compute Value Shares\" for all settlement units first."
msgstr ""

#, python-format
msgctxt "model:ir.message,text:msg_billing_unit_sum_mismatch"
msgid ""
"Cannot set \"Ready for Billing\" for \"%(name)s\": sum of settlement result "
"actual costs (%(sr_sum)s) does not match cost share sum (%(bu_sum)s). Please"
" recompute settlement results."
msgstr ""

#, python-format
msgctxt "model:ir.message,text:msg_billing_unit_zero_actual_costs"
msgid ""
"Cannot set \"Ready for Billing\" for \"%(name)s\": the following settlement results have actual costs of zero:\n"
"%(details)s\n"
"Please enter actual costs for all settlement results before proceeding."
msgstr ""

