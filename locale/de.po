msgctxt "model:ir.message,text:msg_rent_survey_b01"
msgid ""
"B01: \"%(object)s\" is no apartment (use class allowing the comparative "
"rent), or its property has no rent survey with a version valid on %(date)s."
msgstr ""
"B01: „%(object)s“ ist keine Wohnung (Nutzungsklasse mit Verfahren "
"Vergleichsmiete), oder die Wirtschaftseinheit hat keinen Mietspiegel mit "
"einer zum %(date)s gültigen Version."

msgctxt "model:ir.message,text:msg_rent_survey_b02"
msgid "B02: no living space for \"%(object)s\"."
msgstr "B02: keine Wohnfläche für „%(object)s“."

msgctxt "model:ir.message,text:msg_rent_survey_b03"
msgid "B03: no class for the classification feature \"%(dimension)s\"."
msgstr "B03: keine Klasse für das Klassifizierungsmerkmal „%(dimension)s“."

msgctxt "model:ir.message,text:msg_rent_survey_b04"
msgid ""
"B04: %(count)s table cells found for the classes and the living space "
"%(area)s m² - exactly one is required."
msgstr ""
"B04: %(count)s Tabellenfelder zu den Klassen und der Wohnfläche %(area)s m² "
"gefunden – genau eines ist erforderlich."

msgctxt "model:ir.message,text:msg_rent_survey_b05"
msgid ""
"B05: the table cell \"%(cell)s\" is outside the qualified scope - a note in "
"the request is required."
msgstr ""
"B05: Das Tabellenfeld „%(cell)s“ liegt außerhalb des qualifizierten Bereichs "
"– Hinweis im Mieterhöhungsverlangen nötig."

msgctxt "model:ir.message,text:msg_rent_survey_b06"
msgid "B06: the features \"%(feature)s\" and \"%(other)s\" exclude each other."
msgstr "B06: Die Merkmale „%(feature)s“ und „%(other)s“ schließen sich aus."

msgctxt "model:ir.message,text:msg_rent_survey_b07"
msgid "B07: the code \"%(code)s\" (%(level)s) does not exist in the version."
msgstr ""
"B07: Der Code „%(code)s“ (%(level)s) ist in der Version nicht vorhanden."

msgctxt "model:ir.message,text:msg_rent_survey_b08"
msgid "B08: no feature in the group \"%(group)s\" (group = 0)."
msgstr "B08: kein Merkmal in der Gruppe „%(group)s“ (Gruppe = 0)."

msgctxt "model:ir.message,text:msg_rent_survey_b09"
msgid ""
"B09: no value of the measurement \"%(measurement)s\" for the automatic "
"features."
msgstr ""
"B09: kein Wert der Bemessung „%(measurement)s“ für die automatischen "
"Merkmale."

msgctxt "model:ir.message,text:msg_rent_survey_calculation_delete"
msgid ""
"The calculation \"%(calculation)s\" is accepted and cannot be deleted - it is "
"the evidence of the comparative rent."
msgstr ""
"Die Berechnung „%(calculation)s“ ist freigegeben und kann nicht gelöscht "
"werden – sie ist der Nachweis der Vergleichsmiete."

msgctxt "model:ir.message,text:msg_rent_survey_calculation_locked"
msgid ""
"The calculation \"%(calculation)s\" is calculated resp. accepted and cannot "
"be changed - use \"Recalculate\"."
msgstr ""
"Die Berechnung „%(calculation)s“ ist berechnet bzw. freigegeben und kann "
"nicht geändert werden – „Neu berechnen“ verwenden."

msgctxt "model:ir.message,text:msg_rent_survey_cell_classes"
msgid ""
"Table cell \"%(cell)s\": exactly one class is required per classification "
"feature."
msgstr ""
"Tabellenfeld „%(cell)s“: Je Klassifizierungsmerkmal ist genau eine Klasse "
"erforderlich."

msgctxt "model:ir.message,text:msg_rent_survey_cell_overlap"
msgid "The area ranges of the table cells \"%(cell)s\" and \"%(other)s\" overlap."
msgstr ""
"Die Flächenbereiche der Tabellenfelder „%(cell)s“ und „%(other)s“ "
"überschneiden sich."

msgctxt "model:ir.message,text:msg_rent_survey_cell_values"
msgid ""
"Table cell \"%(cell)s\": the values must satisfy lower <= mean <= upper "
"(regression: mean required)."
msgstr ""
"Tabellenfeld „%(cell)s“: Es muss Unterwert ≤ Mittelwert ≤ Oberwert gelten "
"(Regression: Mittelwert Pflicht)."

msgctxt "model:ir.message,text:msg_rent_survey_check_ok"
msgid "Check without problems."
msgstr "Prüfung ohne Befund."

msgctxt "model:ir.message,text:msg_rent_survey_check_problems"
msgid "%(count)s problems found:"
msgstr "%(count)s Probleme gefunden:"

msgctxt "model:ir.message,text:msg_rent_survey_code_unique"
msgid "The code must be unique within the rent survey version."
msgstr "Der Code muss innerhalb der Mietspiegel-Version eindeutig sein."

msgctxt "model:ir.message,text:msg_rent_survey_error"
msgid "Error"
msgstr "Fehler"

msgctxt "model:ir.message,text:msg_rent_survey_import_class"
msgid "Unknown class \"%(dimension)s=%(class_)s\"."
msgstr "Unbekannte Klasse „%(dimension)s=%(class_)s“."

msgctxt "model:ir.message,text:msg_rent_survey_import_count"
msgid "%(count)s records"
msgstr "%(count)s Datensätze"

msgctxt "model:ir.message,text:msg_rent_survey_import_feature"
msgid "Unknown feature \"%(feature)s\" in the exclusions."
msgstr "Unbekanntes Merkmal „%(feature)s“ bei den Ausschlüssen."

msgctxt "model:ir.message,text:msg_rent_survey_import_measurement"
msgid "Unknown measurement type \"%(measurement)s\"."
msgstr "Unbekannte Bemessungsart „%(measurement)s“."

msgctxt "model:ir.message,text:msg_rent_survey_info"
msgid "Note"
msgstr "Hinweis"

msgctxt "model:ir.message,text:msg_rent_survey_no_version"
msgid ""
"No rent survey version is valid today for \"%(object)s\" (rent survey of the "
"property)."
msgstr ""
"Für „%(object)s“ ist heute keine Mietspiegel-Version gültig (Mietspiegel der "
"Wirtschaftseinheit)."

msgctxt "model:ir.message,text:msg_rent_survey_origin_derived"
msgid "derived"
msgstr "abgeleitet"

msgctxt "model:ir.message,text:msg_rent_survey_origin_manual"
msgid "manual"
msgstr "manuell"

msgctxt "model:ir.message,text:msg_rent_survey_protocol_cell"
msgid ""
"Living space %(area)s m² → cell %(cell)s: %(lower)s / %(mean)s / %(upper)s "
"€/m²"
msgstr ""
"Wohnfläche %(area)s m² → Feld %(cell)s: %(lower)s / %(mean)s / %(upper)s €/m²"

msgctxt "model:ir.message,text:msg_rent_survey_protocol_class"
msgid "%(dimension)s: %(name)s (%(level)s, %(origin)s)"
msgstr "%(dimension)s: %(name)s (%(level)s, %(origin)s)"

msgctxt "model:ir.message,text:msg_rent_survey_protocol_header"
msgid "%(version)s (valid from %(valid_from)s), key date %(date)s"
msgstr "%(version)s (gültig ab %(valid_from)s), Stichtag %(date)s"

msgctxt "model:ir.message,text:msg_rent_survey_protocol_ignored"
msgid "Feature %(feature)s ignored (not valid for the classes)."
msgstr "Merkmal %(feature)s nicht berücksichtigt (gilt nicht für die Klassen)."

msgctxt "model:ir.message,text:msg_rent_survey_protocol_regression"
msgid ""
"Base value %(mean)s with surcharges and reductions → %(rent)s €/m² (range "
"%(lower)s – %(upper)s)"
msgstr ""
"Basiswert %(mean)s mit Zu- und Abschlägen → %(rent)s €/m² (Spanne %(lower)s –"
" %(upper)s)"

msgctxt "model:ir.message,text:msg_rent_survey_protocol_result"
msgid "Local comparative rent: %(rent)s €/m² × %(area)s m² = %(total)s €"
msgstr "Ortsübliche Vergleichsmiete: %(rent)s €/m² × %(area)s m² = %(total)s €"

msgctxt "model:ir.message,text:msg_rent_survey_protocol_table"
msgid ""
"Net groups %(votes)s, %(percent)s %% per group from the mean %(mean)s → "
"%(rent)s €/m²"
msgstr ""
"Saldo %(votes)s, %(percent)s %% je Gruppe vom Mittelwert %(mean)s → %(rent)s "
"€/m²"

msgctxt "model:ir.message,text:msg_rent_survey_reason_required"
msgid ""
"The calculation \"%(calculation)s\" has warnings or a different accepted rent"
" per m² - enter a reason."
msgstr ""
"Die Berechnung „%(calculation)s“ hat Warnungen oder eine abweichende "
"freigegebene m²-Miete – bitte eine Begründung eingeben."

msgctxt "model:ir.message,text:msg_rent_survey_version_locked"
msgid ""
"The rent survey version \"%(version)s\" is used by an accepted calculation - "
"classes, table, features and rules can only be corrected by a new version."
msgstr ""
"Die Mietspiegel-Version „%(version)s“ wird von einer freigegebenen Berechnung"
" verwendet – Klassen, Tabelle, Merkmale und Regeln können nur über eine neue "
"Version korrigiert werden."

msgctxt "model:ir.message,text:msg_rent_survey_version_unique"
msgid "A rent survey can have only one version per \"valid from\" date."
msgstr "Ein Mietspiegel kann je Datum „gültig ab“ nur eine Version haben."

msgctxt "model:ir.message,text:msg_rent_survey_warning"
msgid "Warning"
msgstr "Warnung"

msgctxt "model:ir.model.button,help:base_object_rent_survey_calculate_button"
msgid "Calculate the local comparative rent of the rental unit as of today."
msgstr ""
"Ortsübliche Vergleichsmiete des Mietobjekts zum heutigen Tag berechnen."

msgctxt "model:ir.model.button,help:base_object_rent_survey_features_button"
msgid "Checklist of the rent survey features of this level."
msgstr "Checkliste der Mietspiegel-Merkmale dieser Ebene."

msgctxt "model:ir.model.button,help:rent_survey_calculation_accept_button"
msgid ""
"Accept the calculation (mandatory step) - a reason is required with warnings "
"or a different rent per m²."
msgstr ""
"Berechnung freigeben (Pflichtschritt) – bei Warnungen oder abweichender m²-"
"Miete ist eine Begründung nötig."

msgctxt "model:ir.model.button,help:rent_survey_calculation_recalculate_button"
msgid ""
"Calculate again with the current data - in place while not accepted or "
"rejected, else as a new calculation."
msgstr ""
"Mit den aktuellen Daten neu berechnen – solange nicht freigegeben oder "
"abgelehnt in derselben Berechnung, sonst als neue Berechnung."

msgctxt "model:ir.model.button,help:rent_survey_version_check_button"
msgid ""
"Check the consistency of the version (classes per cell, values, overlapping "
"area ranges)."
msgstr ""
"Konsistenz der Version prüfen (Klassen je Feld, Werte, überschneidende "
"Flächenbereiche)."

msgctxt "model:ir.model.button,help:rent_survey_version_import_data_button"
