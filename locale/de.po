msgctxt "help:real_estate.re_accounting,receipt_days:"
msgid ""
"Days from the declaration date to the expected receipt by the tenant - only a"
" preview of the effective date of an index rent adjustment, the actual "
"receipt has to be confirmed."
msgstr ""
"Tage vom Erklärungsdatum bis zum erwarteten Zugang beim Mieter - nur Vorschau"
" des Wirksamkeitsdatums einer Indexanpassung, der tatsächliche Zugang ist zu "
"bestätigen."

msgctxt "model:ir.message,text:msg_index_adjustment_values"
msgid ""
"Index values missing: the series \"%(index)s\" needs final values of the "
"reference month %(month_old)s and of a later new month %(month_new)s in the "
"current base year %(base_year)s."
msgstr ""
"Indexwerte fehlen: Die Reihe \"%(index)s\" braucht endgültige Werte für den "
"Bezugsmonat %(month_old)s und einen späteren neuen Monat %(month_new)s im "
"aktuellen Basisjahr %(base_year)s."

msgctxt "model:ir.message,text:msg_index_adjustment_threshold"
msgid "The agreed threshold is not reached (change %(change)s %%)."
msgstr ""
"Die vereinbarte Schwelle ist nicht erreicht (Veränderung %(change)s %%)."

msgctxt "model:ir.message,text:msg_index_adjustment_cap_value"
msgid "Cap rule: the index value of %(month)s is missing."
msgstr "Kappungsregel: Der Indexwert für %(month)s fehlt."

msgctxt "model:ir.message,text:msg_index_adjustment_rounding"
msgid ""
"Rounding: quantity x new unit price differs from the new amount %(amount)s - "
"the new amount is decisive."
msgstr ""
"Rundung: Menge x neuer Einzelpreis weicht vom neuen Betrag %(amount)s ab - "
"maßgeblich ist der neue Betrag."

msgctxt "model:ir.message,text:msg_index_adjustment_decrease"
msgid "The index has decreased - the tenant can claim a rent reduction."
msgstr ""
"Der Index ist gesunken - der Mieter kann eine Senkung der Miete verlangen."

msgctxt "model:ir.message,text:msg_index_adjustment_lock_period"
msgid ""
"The rent has to remain unchanged for at least 12 months (§ 557b para. 2 BGB):"
" effective date %(valid_from)s is before %(next_date)s."
msgstr ""
"Die Miete muss mindestens 12 Monate unverändert bleiben (§ 557b Abs. 2 BGB): "
"Wirksamkeit %(valid_from)s liegt vor dem %(next_date)s."

msgctxt "model:ir.message,text:msg_index_adjustment_contract_state"
msgid "The contract \"%(contract)s\" is not running."
msgstr "Der Vertrag \"%(contract)s\" ist nicht aktiv."

msgctxt "model:ir.message,text:msg_index_adjustment_contract_end"
msgid ""
"The effective date %(valid_from)s is after the end of the contract %(end)s."
msgstr ""
"Das Wirksamkeitsdatum %(valid_from)s liegt nach dem Vertragsende %(end)s."

msgctxt "model:ir.message,text:msg_index_adjustment_booked"
msgid ""
"The term \"%(term)s\" is booked up to %(booked_to)s, beyond the effective "
"date %(valid_from)s - cancel the postings first."
msgstr ""
"Die Kondition \"%(term)s\" ist bis %(booked_to)s gebucht, also über das "
"Wirksamkeitsdatum %(valid_from)s hinaus - zuerst die Buchungen stornieren."

msgctxt "model:ir.message,text:msg_index_adjustment_locked"
msgid "The term \"%(term)s\" is locked by a graduated rent."
msgstr "Die Kondition \"%(term)s\" ist durch eine Staffelmiete gesperrt."

msgctxt "model:ir.message,text:msg_index_adjustment_approve_error"
msgid ""
"The adjustment \"%(adjustment)s\" has errors and cannot be approved:\n"
"%(protocol)s"
msgstr ""
"Der Vorgang \"%(adjustment)s\" hat Fehler und kann nicht freigegeben werden:\n"
"%(protocol)s"

msgctxt "model:ir.message,text:msg_index_adjustment_approve_warning"
msgid ""
"The adjustment \"%(adjustment)s\" has findings:\n"
"%(protocol)s"
msgstr ""
"Der Vorgang \"%(adjustment)s\" hat Befunde:\n"
"%(protocol)s"

msgctxt "model:ir.message,text:msg_index_adjustment_cancel_declared"
msgid "The tenant has already received a declaration for: %(adjustments)s."
msgstr "Dem Mieter liegt bereits eine Erklärung vor für: %(adjustments)s."

msgctxt "model:ir.message,text:msg_index_adjustment_open"
msgid "\"%(rent_adjustment)s\" already has an open adjustment \"%(adjustment)s\"."
msgstr "\"%(rent_adjustment)s\" hat bereits einen offenen Vorgang \"%(adjustment)s\"."

msgctxt "model:ir.message,text:msg_index_adjustment_delete"
msgid ""
"The adjustment \"%(adjustment)s\" can only be deleted in state draft or "
"cancelled."
msgstr ""
"Der Vorgang \"%(adjustment)s\" kann nur im Status Entwurf oder Storniert "
"gelöscht werden."

msgctxt "model:ir.message,text:msg_index_rent_draft_adjustments"
msgid ""
"Rent adjustment \"%(rent_adjustment)s\" cannot be reset to draft: the "
"adjustment \"%(adjustment)s\" is already approved, declared or done."
msgstr ""
"Die Mietanpassung \"%(rent_adjustment)s\" kann nicht auf Entwurf "
"zurückgesetzt werden: die Anpassung \"%(adjustment)s\" ist bereits "
"freigegeben, erklärt oder ausgeführt."

msgctxt "model:ir.message,text:msg_index_rent_close_open"
msgid ""
"Rent adjustment \"%(rent_adjustment)s\" cannot be closed: the adjustment "
"\"%(adjustment)s\" is still open."
msgstr ""
"Die Mietanpassung \"%(rent_adjustment)s\" kann nicht beendet werden: die "
"Anpassung \"%(adjustment)s\" ist noch offen."

msgctxt "model:ir.message,text:msg_price_index_value_used"
msgid ""
"The index value \"%(value)s\" is used by the declared or executed adjustment "
"\"%(adjustment)s\" and cannot be changed."
msgstr ""
"Der Indexwert \"%(value)s\" wird im erklärten oder ausgeführten Vorgang "
"\"%(adjustment)s\" verwendet und kann nicht geändert werden."

msgctxt "field:real_estate.contract.rent_adjustment,declaration_deadline:"
msgid "Declaration until"
msgstr "Erklärung bis"

msgctxt "help:real_estate.contract.rent_adjustment,declaration_deadline:"
msgid ""
"Follow-up: latest date to send the declaration so that the adjustment takes "
"effect on the next possible date (receipt in the month before last, minus the"
" receipt days of the real estate accounting) - start the adjustment run "
"before this date."
msgstr ""
"Wiedervorlage: spätestes Datum für den Versand der Erklärung, damit die "
"Anpassung zum nächstmöglichen Termin wirksam wird (Zugang im vorletzten "
"Monat, abzüglich der Zugangstage der Immobilien-Buchhaltung) - den "
"Anpassungslauf vor diesem Datum starten."

