#, python-format
msgctxt ""
"model:ir.message,text:msg_settlement_unit_allocation_rule_not_allowed_external"
msgid ""
"\"%(name)s\": the allocation rule \"Allocation from external billing\" is "
"only allowed for a billing unit with external billing."
msgstr ""
"„%(name)s“: die Verteilungsregel „Verteilung aus externer Abrechnung“ ist "
"nur für eine Abrechnungseinheit mit externer Abrechnung zulässig."

#, python-format
msgctxt ""
"model:ir.message,text:msg_settlement_unit_allocation_rule_required_external"
msgid ""
"\"%(name)s\": for a billing unit with external billing, the allocation rule "
"must be \"Allocation from external billing\" or \"Allocation via cost "
"collector\"."
msgstr ""
"„%(name)s“: bei einer Abrechnungseinheit mit externer Abrechnung muss die "
"Verteilungsregel „Verteilung aus externer Abrechnung“ oder „Umlage über "
"Kostensammler“ sein."

#, python-format
