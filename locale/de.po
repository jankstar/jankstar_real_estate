msgid "GENESIS Table"
msgstr "GENESIS-Tabelle"

msgctxt "help:real_estate.price_index,genesis_table:"
msgid ""
"GENESIS-Online table code, e.g. 61111-0002 (consumer price index: Germany, "
"months)."
msgstr ""
"Tabellencode in GENESIS-Online, z. B. 61111-0002 (Verbraucherpreisindex: "
"Deutschland, Monate)."

msgctxt "field:real_estate.price_index,genesis_series:"
msgid "GENESIS Series"
msgstr "GENESIS-Reihe"

msgctxt "help:real_estate.price_index,genesis_series:"
msgid "Characteristic of the table if it holds several series."
msgstr "Merkmal der Tabelle, falls sie mehrere Reihen enthält."

msgctxt "field:real_estate.price_index,base_year:"
msgid "Base Year"
msgstr "Basisjahr"

msgctxt "help:real_estate.price_index,base_year:"
msgid ""
"Current base year of the series (base year = 100). Changes are always "
"calculated within this base year."
msgstr ""
"Aktuelles Basisjahr der Reihe (Basisjahr = 100). Veränderungen werden immer "
"innerhalb dieses Basisjahres berechnet."

msgctxt "field:real_estate.price_index,residential_allowed:"
msgid "Allowed for Residential"
msgstr "Für Wohnraum zulässig"

msgctxt "help:real_estate.price_index,residential_allowed:"
msgid ""
"Index allowed for residential index rents (§ 557b BGB: only the consumer "
"price index for Germany of Destatis)."
msgstr ""
"Index für Indexmieten bei Wohnraum zulässig (§ 557b BGB: nur der "
"Verbraucherpreisindex für Deutschland des Statistischen Bundesamts)."

