        <record model="ir.rule.group" id="rule_group_task_companies">
            <field name="name">User in companies</field>
            <field name="model">real_estate.task</field>
            <field name="global_p" eval="True"/>
        </record>
        <record model="ir.rule" id="rule_task_companies">
            <field name="domain" eval="[('company', 'in', Eval('companies', []))]" pyson="1"/>
            <field name="rule_group" ref="rule_group_task_companies"/>
        </record>
        <record model="ir.rule.group" id="rule_group_task_mine">
            <field name="name">Own or group tasks</field>
            <field name="model">real_estate.task</field>
            <field name="global_p" eval="False"/>
            <field name="default_p" eval="False"/>
        </record>
        <record model="ir.rule" id="rule_task_mine">
            <field name="domain" eval="['OR', ('responsible_user', '=', Eval('user_id', -1)), ('responsible_group', 'in', Eval('groups', [])), ('create_uid', '=', Eval('user_id', -1))]" pyson="1"/>
            <field name="rule_group" ref="rule_group_task_mine"/>
