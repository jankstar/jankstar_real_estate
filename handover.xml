        </record>
        <record model="ir.action.act_window.domain" id="act_handover_domain_draft">
            <field name="name">Draft</field>
            <field name="sequence" eval="10"/>
            <field name="domain" eval="[('state', '=', 'draft')]" pyson="1"></field>
            <field name="count" eval="True"/>
            <field name="act_window" ref="act_handover"/>
        </record>
        <record model="ir.action.act_window.domain" id="act_handover_domain_done">
            <field name="name">Done</field>
