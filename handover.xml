        <record model="ir.action.act_window" id="act_handover">
            <field name="name">Handover Reports</field>
            <field name="res_model">real_estate.contract.handover</field>
        </record>
        <record model="ir.action.act_window.view" id="act_handover_view1">
            <field name="sequence" eval="10"/>
            <field name="view" ref="handover_view_tree"/>
            <field name="act_window" ref="act_handover"/>
        </record>
