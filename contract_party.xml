<tryton>

    <data>

        <record model="ir.ui.view" id="contract_party_view_list">
            <field name="model">real_estate.contract.party</field>
            <field name="type">tree</field>
            <field name="name">contract_party_list</field>
        </record>

        <record model="ir.ui.view" id="contract_party_view_form">
            <field name="model">real_estate.contract.party</field>
            <field name="type">form</field>
            <field name="name">contract_party_form</field>
        </record>

        <record model="ir.action.act_window" id="act_contract_party_tree">
            <field name="name">Contract Parties</field>
            <field name="res_model">real_estate.contract.party</field>
        </record>

        <record model="ir.action.act_window.view" id="act_contract_party_tree_view1">
            <field name="sequence" eval="10"/>
            <field name="view" ref="contract_party_view_list"/>
            <field name="act_window" ref="act_contract_party_tree"/>
        </record>
        <record model="ir.action.act_window.view" id="act_contract_party_tree_view2">
            <field name="sequence" eval="20"/>
            <field name="view" ref="contract_party_view_form"/>
            <field name="act_window" ref="act_contract_party_tree"/>
        </record>

        <record model="ir.ui.view" id="contract_party_role_view_list">
            <field name="model">real_estate.contract.party.role</field>
            <field name="type">tree</field>
            <field name="name">contract_party_role_list</field>
        </record>
        <record model="ir.ui.view" id="contract_party_role_view_form">
            <field name="model">real_estate.contract.party.role</field>
            <field name="type">form</field>
            <field name="name">contract_party_role_form</field>
        </record>
        <record model="ir.action.act_window" id="act_contract_party_role">
            <field name="name">Contract Party Roles</field>
            <field name="res_model">real_estate.contract.party.role</field>
        </record>
        <record model="ir.action.act_window.view" id="act_contract_party_role_view1">
            <field name="sequence" eval="10"/>
            <field name="view" ref="contract_party_role_view_list"/>
            <field name="act_window" ref="act_contract_party_role"/>
        </record>
        <record model="ir.action.act_window.view" id="act_contract_party_role_view2">
