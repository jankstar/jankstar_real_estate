            <field name="view" ref="contract_party_role_view_form"/>
            <field name="act_window" ref="act_contract_party_role"/>
        </record>

        <!-- Change Contract Partner Wizard -->
        <record model="ir.ui.view" id="change_contract_partner_start_view_form">
            <field name="model">real_estate.change_contract_partner.start</field>
            <field name="type">form</field>
            <field name="name">change_contract_partner_start_form</field>
        </record>
        <record model="ir.action.wizard" id="wizard_change_contract_partner">
            <field name="name">Change Partner</field>
            <field name="wiz_name">real_estate.change_contract_partner.wizard</field>
        </record>

        <!-- ContractParty: Contract group full access, Object/Billing read -->
        <record model="ir.model.access" id="access_contract_party_contract_group">
            <field name="model">real_estate.contract.party</field>
            <field name="group" ref="group_real_estate_contract"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="True"/>
        </record>
        <record model="ir.model.access" id="access_contract_party_admin">
            <field name="model">real_estate.contract.party</field>
            <field name="group" ref="group_real_estate_admin"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="True"/>
        </record>
        <record model="ir.model.access" id="access_contract_party_object_group">
            <field name="model">real_estate.contract.party</field>
            <field name="group" ref="group_real_estate_object"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_contract_party_billing">
            <field name="model">real_estate.contract.party</field>
            <field name="group" ref="group_real_estate_billing"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_contract_party_default">
            <field name="model">real_estate.contract.party</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>

        <!-- ContractPartyRole: Configuration - Admin write, others read -->
        <record model="ir.model.access" id="access_contract_party_role_admin">
            <field name="model">real_estate.contract.party.role</field>
            <field name="group" ref="group_real_estate_admin"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="True"/>
        </record>
        <record model="ir.model.access" id="access_contract_party_role_contract_group">
            <field name="model">real_estate.contract.party.role</field>
            <field name="group" ref="group_real_estate_contract"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_contract_party_role_object_group">
            <field name="model">real_estate.contract.party.role</field>
            <field name="group" ref="group_real_estate_object"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_contract_party_role_billing">
            <field name="model">real_estate.contract.party.role</field>
            <field name="group" ref="group_real_estate_billing"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_contract_party_role_default">
            <field name="model">real_estate.contract.party.role</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>

        <menuitem
            parent="menu_real_estate_configuration"
            sequence="25"
            action="act_contract_party_role"
            id="menu_contract_party_role"/>

        <menuitem
            parent="menu_real_estate_parties"
            action="act_contract_party_tree"
            sequence="30"
            id="menu_contract_parties_form"/>

    </data>

    <data noupdate="1">

        <!-- Contract types: defined here (not in contract.xml) because
             they refer to the party roles and to the process templates of
             process.xml, which is loaded after contract.xml -->
        <!-- Contract party roles: exactly one main tenant at any time
             (mandatory, only once), any number of secondary tenants; the
             owner is the main tenant role of the condominium fee
             agreement;
             the contract types below refer to them, the applicable
             contract types per role follow below -->
        <record model="real_estate.contract.party.role" id="contract_party_role_main_tenant">
            <field name="name">Hauptmieter</field>
            <field name="sequence">10</field>
            <field name="default" eval="False"/>
            <field name="mandatory" eval="True"/>
            <field name="only_once" eval="True"/>
        </record>

        <record model="real_estate.contract.party.role" id="contract_party_role_secondary_tenant">
            <field name="name">Nebenmieter</field>
            <field name="sequence">20</field>
            <field name="default" eval="False"/>
            <field name="mandatory" eval="False"/>
            <field name="only_once" eval="False"/>
        </record>

        <record model="real_estate.contract.party.role" id="contract_party_role_owner">
            <field name="name">Eigentümer</field>
            <field name="default" eval="False"/>
            <field name="mandatory" eval="True"/>
            <field name="only_once" eval="False"/>
        </record>

        <record model="real_estate.contract.type" id="contract_rental_agreement_type">
            <field name="start_process_template" ref="process_template_move_in"/>
            <field name="termination_process_template" ref="process_template_move_out"/>
            <field name="partner_change_process_template" ref="process_template_partner_change"/>
            <field name="main_tenant_role" ref="contract_party_role_main_tenant"/>
            <field name="secondary_tenant_role" ref="contract_party_role_secondary_tenant"/>
            <field name="re_accounting" ref="re_accounting_default"/>
            <field name="name">Rental agreement</field>
            <field name="sequence">10</field>
            <field name="mark" >Debit</field>
            <field name="occupancy" eval="True"/>
            <field name="prefix" >1</field>
            <field name='start_number'>1000</field>
            <field name="step_term">10</field>
            <field name="step_item">10</field>
            <field name="account_journal" ref="journal_rental_book"/> 
            <field name="invoice_type">out</field>
            <field name="types_of_use" eval="['residential']"/>
            <field name="oc_mark" >Operating Cost Settlement</field>
            <field name="adjustment_procedures" eval="['graduated_rent', 'index_rent', 'comparative_rent', 'modernisation', 'operation_costs_billing', 'operation_costs_plan', 'free_adjustment']"/>
        </record>

        <record model="real_estate.contract.type" id="contract_parking_space_lease_agreement_type">
            <field name="main_tenant_role" ref="contract_party_role_main_tenant"/>
            <field name="secondary_tenant_role" ref="contract_party_role_secondary_tenant"/>
            <field name="re_accounting" ref="re_accounting_default"/>
            <field name="name">Parking Space Lease Agreement</field>
            <field name="sequence">20</field>
            <field name="mark" >Debit</field>
            <field name="occupancy" eval="True"/>
            <field name="prefix" >2</field>
            <field name='start_number'>2000</field>
            <field name="step_term">10</field>
            <field name="step_item">10</field>
            <field name="account_journal" ref="journal_rental_book"/> 
            <field name="invoice_type">out</field>
            <field name="types_of_use" eval="['residential']"/>
            <field name="oc_mark" >Operating Cost Settlement</field>
            <field name="adjustment_procedures" eval="['graduated_rent', 'index_rent', 'free_adjustment']"/>
        </record>

        <record model="real_estate.contract.type" id="contract_debit_costs_agreement_type">
            <field name="main_tenant_role" ref="contract_party_role_main_tenant"/>
            <field name="secondary_tenant_role" ref="contract_party_role_secondary_tenant"/>
            <field name="re_accounting" ref="re_accounting_default"/>
            <field name="name">Debit Costs Agreement</field>
            <field name="sequence">30</field>
            <field name="mark" >Debit</field>
            <field name="prefix" >3</field>
            <field name='start_number'>3000</field>
            <field name="step_term">10</field>
            <field name="step_item">10</field>
            <field name="account_journal" ref="journal_rental_book"/>
            <field name="invoice_type">out</field>
            <field name="types_of_use" eval="['residential', 'commercial', 'property', 'internal']"/>
            <field name="oc_mark" >Operating Cost Settlement</field>
            <field name="adjustment_procedures" eval="['operation_costs_billing', 'operation_costs_plan', 'free_adjustment']"/>
        </record>

        <record model="real_estate.contract.type" id="contract_credit_costs_agreement_type">
            <field name="main_tenant_role" ref="contract_party_role_main_tenant"/>
            <field name="secondary_tenant_role" ref="contract_party_role_secondary_tenant"/>
            <field name="re_accounting" ref="re_accounting_default"/>
            <field name="name">Credit Costs Agreement</field>
            <field name="sequence">40</field> 
            <field name="mark" >Credit</field>
            <field name="prefix" >4</field>
            <field name='start_number'>4000</field>
            <field name="step_term">10</field>
            <field name="step_item">10</field>
            <field name="account_journal" ref="journal_rental_book"/> 
            <field name="invoice_type">in</field>
            <field name="types_of_use" eval="['residential', 'commercial', 'property', 'internal']"/>
            <field name="oc_mark" >Operating Cost Settlement</field>
            <field name="adjustment_procedures" eval="['free_adjustment']"/>
        </record>

        <record model="real_estate.contract.type" id="contract_commercial_lease_agreement_type">
            <field name="main_tenant_role" ref="contract_party_role_main_tenant"/>
            <field name="secondary_tenant_role" ref="contract_party_role_secondary_tenant"/>
            <field name="re_accounting" ref="re_accounting_default"/>
            <field name="name">Commercial lease agreement</field>
            <field name="sequence">50</field>
            <field name="mark" >Debit</field>
            <field name="occupancy" eval="True"/>
            <field name="prefix" >5</field>
            <field name='start_number'>5000</field>
            <field name="step_term">10</field>
            <field name="step_item">10</field>
            <field name="account_journal" ref="journal_rental_book"/> 
            <field name="invoice_type">out</field>
            <field name="types_of_use" eval="['commercial']"/>
            <field name="oc_mark" >Operating Cost Settlement</field>
            <field name="adjustment_procedures" eval="['graduated_rent', 'index_rent', 'operation_costs_billing', 'operation_costs_plan', 'free_adjustment']"/>
        </record>

        <record model="real_estate.contract.type" id="contract_condominium_fee_agreement_type">
            <field name="main_tenant_role" ref="contract_party_role_owner"/>
            <field name="re_accounting" ref="re_accounting_default"/>
            <field name="name">Condominium fee agreement</field>
            <field name="sequence">80</field>
            <field name="mark" >Debit</field>
            <field name="occupancy" eval="True"/>
            <field name="prefix" >8</field>
            <field name='start_number'>8000</field>
            <field name="step_term">10</field>
            <field name="step_item">10</field>
            <field name="account_journal" ref="journal_rental_book"/> 
            <field name="invoice_type">out</field>
            <field name="types_of_use" eval="['property']"/>
            <field name="oc_mark" >Operating Cost Settlement</field>
            <field name="adjustment_procedures" eval="['operation_costs_plan', 'free_adjustment']"/>
        </record>

        <!-- Applicable contract types per role, via the M2M relation model -->
        <record model="real_estate.contract.party.role-contract.type"
                id="contract_party_role_main_tenant_rental">
            <field name="role" ref="contract_party_role_main_tenant"/>
            <field name="c_type" ref="contract_rental_agreement_type"/>
        </record>
        <record model="real_estate.contract.party.role-contract.type"
                id="contract_party_role_main_tenant_parking">
            <field name="role" ref="contract_party_role_main_tenant"/>
            <field name="c_type" ref="contract_parking_space_lease_agreement_type"/>
        </record>
        <record model="real_estate.contract.party.role-contract.type"
                id="contract_party_role_main_tenant_debit_costs">
            <field name="role" ref="contract_party_role_main_tenant"/>
            <field name="c_type" ref="contract_debit_costs_agreement_type"/>
        </record>
        <record model="real_estate.contract.party.role-contract.type"
                id="contract_party_role_main_tenant_credit_costs">
            <field name="role" ref="contract_party_role_main_tenant"/>
            <field name="c_type" ref="contract_credit_costs_agreement_type"/>
        </record>
        <record model="real_estate.contract.party.role-contract.type"
                id="contract_party_role_main_tenant_commercial">
            <field name="role" ref="contract_party_role_main_tenant"/>
            <field name="c_type" ref="contract_commercial_lease_agreement_type"/>
        </record>
        <record model="real_estate.contract.party.role-contract.type"
                id="contract_party_role_secondary_tenant_rental">
            <field name="role" ref="contract_party_role_secondary_tenant"/>
            <field name="c_type" ref="contract_rental_agreement_type"/>
        </record>
        <record model="real_estate.contract.party.role-contract.type"
                id="contract_party_role_secondary_tenant_parking">
            <field name="role" ref="contract_party_role_secondary_tenant"/>
            <field name="c_type" ref="contract_parking_space_lease_agreement_type"/>
        </record>
        <record model="real_estate.contract.party.role-contract.type"
                id="contract_party_role_secondary_tenant_debit_costs">
            <field name="role" ref="contract_party_role_secondary_tenant"/>
            <field name="c_type" ref="contract_debit_costs_agreement_type"/>
        </record>
        <record model="real_estate.contract.party.role-contract.type"
                id="contract_party_role_secondary_tenant_credit_costs">
            <field name="role" ref="contract_party_role_secondary_tenant"/>
            <field name="c_type" ref="contract_credit_costs_agreement_type"/>
        </record>
        <record model="real_estate.contract.party.role-contract.type"
                id="contract_party_role_secondary_tenant_commercial">
            <field name="role" ref="contract_party_role_secondary_tenant"/>
            <field name="c_type" ref="contract_commercial_lease_agreement_type"/>
        </record>
        <record model="real_estate.contract.party.role-contract.type"
                id="contract_party_role_owner_condominium">
            <field name="role" ref="contract_party_role_owner"/>
            <field name="c_type" ref="contract_condominium_fee_agreement_type"/>
        </record>

    </data>

</tryton>
