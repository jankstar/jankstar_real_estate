<?xml version="1.0"?>
<form col="4">
    <label name="sequence"/><field name="sequence"/>
    <label name="name"/><field name="name"/>
    <label name="compute_name"/><field name="compute_name"/>
    <label name="active"/><field name="active"/>
    <label name="re_accounting"/><field name="re_accounting"/>
    <label name="account"/><field name="account"/>
    <label name="oc_processing"/><field name="oc_processing"/>
    <label name="amount_sign"/><field name="amount_sign"/>

    <group string="Usage" id="usage" colspan="4" col="2" homogeneous="1"
        yexpand="1" yfill="1">
        <group id="types_of_use" col="1" yexpand="1" yfill="1">
            <label name="types_of_use" xalign="0"/>
            <field name="types_of_use" yexpand="1" yfill="1"/>
        </group>
        <group id="c_type" col="1" yexpand="1" yfill="1">
            <label name="c_type" xalign="0"/>
            <field name="c_type" yexpand="1" yfill="1"/>
        </group>
    </group>

    <group string="Quantity and Measurement" id="m_type" colspan="4" col="4">
        <label name="m_type"/><field name="m_type"/>
        <label name="info_m_type"/><field name="info_m_type"/>
        <label name="default_quantity"/><field name="default_quantity"/>
    </group>

    <group string="Rhythm" id="rhythm" colspan="4" col="6">
        <label name="rhythm"/><field name="rhythm"/>
        <label name="rhythm_type"/><field name="rhythm_type"/>
        <label name="rhythm_start"/><field name="rhythm_start"/>
    </group>

    <group string="Periodic Posting" id="separate_move" colspan="4" col="4">
        <label name="separate_move"/><field name="separate_move"/>
        <label name="move_description"/><field name="move_description"/>
    </group>

    <group string="Rent Adjustment" id="adjustment" colspan="4" col="2">
        <label name="adjustment_procedures"/>
        <field name="adjustment_procedures" widget="multiselection"
            yexpand="0"/>
    </group>
</form>
