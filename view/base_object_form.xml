this repository contains the full copyright notices and license terms. -->
<form col="6">
    <label name="name"/><field name="name" colspan="3"/>
    <label name="type"/><field name="type" />
    <newline/>   

    <label name="company"/><field name="company"/>
    <label name="property"/><field name="property" readonly="1"/>
    <label name="parent"/><field name="parent"/>
    <newline/>   

    <label name="id"/><field name="id" readonly="1"/>
    <label name="sequence"/><field name="sequence" colspan="1"/>
    <label name="object_number"/><field name="object_number" readonly="1"/>
    <newline/>   


    <label name="type_of_use"/><field name="type_of_use" widget="selection"/>
    <label name="use_class"/><field name="use_class"/>

    <group colspan="2" col="-1" id="checkboxes">
        <label name="active"/><field name="active" xexpand="0" width="25"/>
        <label name="state"/><field name="state" widget="selection"/>
    </group>

    <notebook colspan="8">
        <page string="General" id="page_general" col="6">
            <label name="start_date"/><field name="start_date"/>
            <label name="end_date"/><field name="end_date"/>
            <newline/>   

            <label name="address"/><field name="address"/>
            <label name="number_of_objects"/><field name="number_of_objects" readonly="1"/>
            <newline/>
            <label name="tight_market"/><field name="tight_market"/>
            <label name="tight_market_valid_from"/><field name="tight_market_valid_from"/>
            <label name="tight_market_valid_to"/><field name="tight_market_valid_to"/>

            <separator name="comment" colspan="6"/>
            <field name="comment" colspan="6"/>

        </page>
        
        <page string="Rental Object" id="page_object" col="6">
            <label name="floor"/><field name="floor"/>
            <label name="basement_nr"/><field name="basement_nr"/>
            <label name="parking_nr"/><field name="parking_nr"/>

        </page>

        <page string="Building" id="page_building" col="6">
            <label name="year_of_construction"/><field name="year_of_construction"/>
            <label name="number_of_floors"/><field name="number_of_floors"/>


        </page>

        <page string="Equipment" id="page_equipment" col="6">
            <label name="e_type"/><field name="e_type"/>
            <label name="equipment_kind"/><field name="equipment_kind"/>
            <label name="no_print"/><field name="no_print"/>
            <newline/>
            <label name="product"/><field name="product" />
            <newline/>     


        </page>

        <page string='Meters' id="page_meter" col="6">
                <label name="meter_unit"/><field name="meter_unit"/>
                <newline/>
                <label name="meter_factor"/><field name="meter_factor"/>
                <label name="meter_is_counter"/><field name="meter_is_counter"/>
                <label name="meter_no_decimals"/><field name="meter_no_decimals"/>
                <newline/>
                <label name="meter_id"/><field name="meter_id" />
                <newline/>
                <label name="melo_id"/><field name="melo_id" />
                <label name="malo_id"/><field name="malo_id" />
                <newline/>
                <label name="meter_last_reading_date"/><field name="meter_last_reading_date" />
                <label name="meter_last_reading_user"/><field name="meter_last_reading_user" />
                <newline/>
                <label name="meter_calibration_date"/><field name="meter_calibration_date"/>
                <label name="meter_calibration_years"/><field name="meter_calibration_years"/>
                <label name="meter_calibration_valid_to"/><field name="meter_calibration_valid_to"/>
                <label name="meter_calibration_due"/><field name="meter_calibration_due"/>
                <newline/>
                <label name="meter_last_value"/><field name="meter_last_value" />
                <label name="meter_last_consumption"/><field name="meter_last_consumption" />
                <newline/>
                <button name="estimate_consumption" string="Estimate Consumption" icon="real_estate-electric-meter"/>
                <newline/>
                <group colspan="6" id="group_meter">
                    <field name="meter_readings" />
                </group>

        </page>

        <page string="Billing Units" id="page_billing_unit" col="6">
            <label name="billing_as"/><field name="billing_as"/>
            <label name="collective_billing"/><field name="collective_billing"/>
            <label name="next_billing_start_date"/><field name="next_billing_start_date" readonly="1"/>
            <newline/>
            <notebook colspan="6">
                <page string="Billing Unit" id="page_billing_unit_open" col="6">
                    <field name="billing_units_open" colspan="6"
                        view_ids="real_estate.base_object_view_list_billing_unit"/>
                    <button name="compute_value_shares" string="Compute Value Shares" icon="real_estate-pie-chart"/>
                    <button name="compute_settlement_result_property" string="Compute Settlement Results" icon="real_estate-calculate"/>
                    <button name="ready_for_billing_property" string="Ready for Billing" icon="real_estate-fact-check"/>
                    <button name="billing_property" string="Billing" icon="real_estate-request-quote"/>
                </page>
                <page string="Billing Unit (billed)" id="page_billing_unit_billed" col="6">
                    <field name="billing_units_billed" colspan="6" readonly="1"
                        view_ids="real_estate.base_object_view_list_billing_unit"/>
                    <button name="cancel_property" string="Cancel Billing" icon="tryton-cancel"/>
                </page>
            </notebook>
        </page>

        <page string="Occupancy" id="page_occupancy" col="4">
            <button name="refresh_occupancy" string="Refresh Occupancy" colspan="1" icon="tryton-refresh"/>
            <newline/>
            <field name="occupancy" colspan="4"
                view_ids="real_estate.base_object_occupancy_view_tree"
                readonly="1"/>
        </page>
        
        <page name="measurements" col="1">
            <field name="measurements"
                view_ids="real_estate.base_object_view_list_measurement"/>
        </page>

        <page string="Option Rate" id="page_option_rate" col="4">
            <group id="base_object_option_rate" yalign="0">
                <label name="option_rate_method"/><field name="option_rate_method" />
                <newline/>
                <label name="option_measurement_type"/><field name="option_measurement_type"/>
                <newline/>
                <label name="option_rate_value"/><field name="option_rate_value" />
            </group>
            <group id="base_object_option_rate_list">
                <field name="option_rates" 
                    view_ids="real_estate.option_rate_view_tree"/>
            </group>
        </page>

        <page name="parties" col="1">
            <field name="parties"
                view_ids="real_estate.base_object_view_list_object_party"/>
        </page>

        <page string="BVED Provider Assignments"
                id="page_bved_provider_assignments" col="1">
            <field name="bved_provider_assignments"
                view_ids="real_estate.base_object_view_list_bved_provider_assignment"/>
        </page>

        <page name="children" col="1">
            <field name="children"
                view_ids="real_estate.base_object_view_list_children"/>
        </page>
        <page string="Inspections" id="page_inspections" col="1">
            <field name="property_inspection_plans"/>
            <field name="building_inspection_plans"/>
            <field name="property_inspections"/>
            <field name="building_inspections"/>
            <field name="inspection_lines"
                view_ids="real_estate.inspection_line_view_list_object"/>
            <field name="property_defects"/>
            <field name="building_defects"/>
            <field name="object_defects"/>
        </page>
        <page string="Rent Survey" id="page_rent_survey" col="1">
            <notebook>
                <page string="Classes and Features"
                        id="page_rent_survey_values" col="4">
                    <label name="rent_survey"/><field name="rent_survey"/>
                    <field name="rent_survey_version" invisible="1"/>
                    <group id="rent_survey_buttons" colspan="2" col="-1">
                        <button name="rent_survey_features"/>
                        <button name="rent_survey_copy"/>
                        <button name="rent_survey_copy_building"/>
                        <button name="rent_survey_matrix_export"/>
                        <button name="rent_survey_matrix_import"/>
                        <button name="rent_survey_calculate"/>
                    </group>
                    <field name="rent_survey_values" colspan="4"
                        view_ids="real_estate.base_object_rent_survey_value_view_tree"/>
                    <separator name="rent_survey_data" colspan="4"/>
                    <field name="rent_survey_data" colspan="4"/>
                </page>
                <page string="Calculation"
                        id="page_rent_survey_calculations" col="1">
                    <field name="rent_survey_calculations"
                        view_ids="real_estate.rent_survey_calculation_view_tree"/>
                </page>
            </notebook>
        </page>
        <page string="Tasks and Processes" id="page_tasks_processes" col="1">
            <notebook>
                <page string="Open" id="page_tasks_processes_open" col="1">
                    <separator name="tasks_open"/>
                    <field name="tasks_open" view_ids="real_estate.task_view_list_resource"/>
                    <separator name="property_tasks_open"/>
                    <field name="property_tasks_open" view_ids="real_estate.task_view_list_resource"/>
                    <separator name="contract_tasks_open"/>
                    <field name="contract_tasks_open" view_ids="real_estate.task_view_list_resource"/>
                    <separator name="processes_open"/>
                    <field name="processes_open"/>
                </page>
                <page string="History" id="page_tasks_processes_history" col="1">
                    <separator name="tasks_history"/>
                    <field name="tasks_history" view_ids="real_estate.task_view_list_resource"/>
                    <separator name="property_tasks_history"/>
                    <field name="property_tasks_history" view_ids="real_estate.task_view_list_resource"/>
                    <separator name="contract_tasks_history"/>
                    <field name="contract_tasks_history" view_ids="real_estate.task_view_list_resource"/>
                    <separator name="processes_history"/>
                    <field name="processes_history"/>
                </page>
            </notebook>
        </page>
    </notebook>

    <button name="draft" string="Draft" colspan="1" icon="tryton-back"/>
    <button name="approved" string="Approved" colspan="1" icon="tryton-ok"/>
    <button name="locked" string="Locked" colspan="1" icon="tryton-close"/>
    <button name="deactivated" string="Deactivated" colspan="1" icon="tryton-close"/>

</form>
