<?xml version="1.0"?>
<form col="4">
    <label name="run_id"/><field name="run_id"/>
    <label name="run_date"/><field name="run_date"/>
    <label name="procedure"/><field name="procedure"/>
    <label name="company"/><field name="company"/>
    <label name="price_index"/><field name="price_index"/>
    <label name="index_month"/><field name="index_month"/>
    <label name="declaration_date"/><field name="declaration_date"/>
