<?xml version="1.0"?>
<data>
    <!-- optional="0": the column can be hidden but is shown by default -->
    <xpath expr="//field[@name='payable_receivable_date']" position="replace">
        <field name="payable_receivable_date" string="Fälligkeitsdatum" optional="0"/>
        <field name="date" string="Buchungsdatum" optional="0"/>
    </xpath>
    <xpath expr="//field[@name='party']" position="replace">
        <field name="party" optional="1"/>
    </xpath>
    <xpath expr="//field[@name='amount']" position="replace">
        <field name="amount" optional="0" sum="1"/>
    </xpath>
    <xpath expr="//field[@name='amount']" position="after">
        <field name="debit" optional="1" sum="1"/>
        <field name="credit" optional="1" sum="1"/>
    </xpath>
    <xpath expr="//field[@name='payable_receivable_balance']" position="replace">
        <field name="payable_receivable_balance" string="Saldo" optional="0"/>
    </xpath>
    <xpath expr="//field[@name='account']" position="replace">
        <field name="account" optional="0"/>
    </xpath>
    <xpath expr="//field[@name='description_used']" position="replace">
        <field name="description_used" optional="0"/>
    </xpath>
</data>
