<?xml version="1.0"?>
<form col="4">
    <label name="name"/><field name="name" colspan="3"/>
    <label name="task_type"/><field name="task_type"/>
    <label name="state"/><field name="state"/>
    <label name="resource"/><field name="resource" colspan="3"/>
    <label name="contract"/><field name="contract"/>
    <label name="property"/><field name="property"/>
    <label name="due_date"/><field name="due_date"/>
    <label name="remind_date"/><field name="remind_date"/>
    <label name="responsible_user"/><field name="responsible_user"/>
    <label name="responsible_group"/><field name="responsible_group"/>
    <label name="responsible_party"/><field name="responsible_party"/>
    <label name="priority"/><field name="priority"/>
    <label name="recurrence_months"/><field name="recurrence_months"/>
    <notebook colspan="4">
        <page name="description" col="1">
            <field name="description"/>
        </page>
        <page name="result" col="1">
            <field name="result"/>
        </page>
        <page string="Details" id="page_details" col="4">
            <label name="company"/><field name="company"/>
            <label name="done_by"/><field name="done_by"/>
            <label name="done_date"/><field name="done_date"/>
            <label name="previous"/><field name="previous"/>
            <label name="notified_date"/><field name="notified_date"/>
            <label name="escalated_date"/><field name="escalated_date"/>
            <label name="automatic"/><field name="automatic"/>
            <label name="process"/><field name="process"/>
            <label name="process_step"/><field name="process_step"/>
            <label name="origin"/><field name="origin"/>
            <label name="origin_key"/><field name="origin_key"/>
        </page>
    </notebook>
    <group id="buttons" colspan="4" col="-1">
        <button name="reopen" icon="tryton-back"/>
        <button name="cancel" icon="tryton-cancel"/>
        <button name="take" icon="tryton-public"/>
        <button name="postpone" icon="tryton-date"/>
        <button name="execute_action" icon="tryton-launch"/>
        <button name="done" icon="tryton-ok"/>
    </group>
</form>
