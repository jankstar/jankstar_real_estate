<?xml version="1.0"?>
<form col="6">
    <label name="name"/><field name="name" colspan="3" readonly="1"/>
    <label name="c_type"/><field name="c_type"/>
    <newline/>   

    <label name="contractual_partner"/><field name="contractual_partner"/>
    <label name="company"/><field name="company"/>
    <label name="property"/><field name="property"/>
    <newline/>   

    <label name="id"/><field name="id" readonly="1"/>
    <label name="sequence"/><field name="sequence"/>
    <label name="contract_number"/><field name="contract_number" readonly="1"/>
    <newline/>   

    <label name="type_of_use"/><field name="type_of_use"/>
    <label name="currency"/><field name="currency"/>
    <group colspan="2" col="-1" id="checkboxes">
        <label name="active"/><field name="active" xexpand="0" width="25"/>
        <label name="state"/><field name="state" widget="selection"/>
    </group>  
    <newline/>   

    <label name="start_date"/><field name="start_date" />
    <label name="end_date"/><field name="end_date" />
    <label name="unlimited"/><field name="unlimited" />
    <newline/>   

    <notebook colspan="8">
        <page string="General" id="page_general" col="6">
            <newline/>
            
            <label name="payment_term"/><field name="payment_term"/>
            <newline/>   
            <label name="invoice_address"/><field name="invoice_address" readonly="1"/>
            <label name="phone_partner"/><field name="phone_partner" readonly="1"/>
            <newline/>   
            <label name="date_of_signature"/><field name="date_of_signature"/>
            <newline/>   
            <label name="start_booking_date"/><field name="start_booking_date"/>

            <separator name="comment" colspan="6"/>
            <field name="comment" colspan="6"/>
        </page>

        <page name="parties" col="6">
            <field name="parties" colspan="6"
                view_ids="real_estate.contract_party_view_list"/>
            <newline/>
            <button name="change_partner" string="Change Partner" icon="real_estate-swap-horiz" colspan="2"/>
        </page>

        <page string="Termination" id="page_termination" col="6">
            <newline/>
            <label name="terminated_by_type"/><field name="terminated_by_type"/>
            <newline/>
            <label name="receipt_of_termination_notice"/><field name="receipt_of_termination_notice"/>
            <newline/>
            <label name="termination_reason"/><field name="termination_reason"/>
            <newline/>
            <label name="termination_notice"/><field name="termination_notice" widget="selection"/>
            <newline/>
            <label name="termination_date"/><field name="termination_date"/>
        </page>
        <page string="Items" id="page_items" col="6">
            <newline/>
            <field name="items" 
                view_ids="real_estate.contract_view_list_object_item"/> 
        </page>
        <page string="Terms" id="page_terms">
            <!--group colspan="2" col="-1" id="next_term_sequence_group">
                <label name="next_term_sequence"/><field name="next_term_sequence"/>
            </group-->
            <newline/>
            <notebook colspan="8">
                <page string="All Terms" id="page_terms_all">
                    <field name="terms"
                        view_ids="real_estate.contract_view_list_object_term"/>
                </page>
                <page string="Current Terms" id="page_terms_current">
                    <label name="current_terms_date"/>
                    <field name="current_terms_date"/>
                    <newline/>
                    <field name="current_terms" colspan="6"
                        view_ids="real_estate.contract_view_list_object_term"
                        readonly="1"/>
                </page>
            </notebook>
        </page>

        <page string="Rent Adjustments" id="page_rent_adjustments">
            <field name="rent_adjustments" colspan="6"/>
        </page>

        <page string="Operation Costs" id="page_operation_costs">
            <newline/>
            <field name="settlement_units" colspan="8"
                view_ids="real_estate.contract_settlement_unit_view_list"
                readonly="1"/>
        </page>
        <page string="Measurements" id="page_measurements">
            <newline/>
            <field name="measurements"
                view_ids="real_estate.contract_view_list_measurement"/>
        </page>
        <page string="Meters" id="page_meters">
            <newline/>
            <field name="meters" />
        </page>
        <page string="Tasks and Processes" id="page_tasks_processes" col="1">
            <notebook>
                <page string="Open" id="page_tasks_processes_open" col="1">
                    <separator name="tasks_open"/>
                    <field name="tasks_open" view_ids="real_estate.task_view_list_resource"/>
                    <separator name="processes_open"/>
                    <field name="processes_open"/>
                </page>
                <page string="History" id="page_tasks_processes_history" col="1">
                    <separator name="tasks_history"/>
                    <field name="tasks_history" view_ids="real_estate.task_view_list_resource"/>
                    <separator name="processes_history"/>
                    <field name="processes_history"/>
                </page>
            </notebook>
        </page>
        <page name="handovers" col="1">
            <field name="handovers"/>
        </page>
    </notebook>
    <newline/>
    <button name="check_new_letting" icon="tryton-search"/>
    <button name="running" string="Running" icon="tryton-forward"/>
    <button name="revert_termination" string="Revert Termination" icon="tryton-back"/>
    <button name="terminate" string="Terminate" icon="tryton-forward"/>
    <button name="cancel" string="Cancel" icon="tryton-cancel"/>
    <button name="open_party_ledger" string="Party Ledger" icon="real_estate-account-balance"/>

</form>