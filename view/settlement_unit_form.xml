<?xml version="1.0"?>
<form col="6">
    <group colspan="4" id="settlement_unit_active">
        <label name="active"/><field name="active" xexpand="0" width="15"/>
        <label name="id"/><field name="id" readonly="1" xexpand="0" width="15"/>
        <label name="sequence"/><field name="sequence"/>
        <label name="name"/><field name="name"/>
    </group>
    <group colspan="2" id="settlement_unit_state">
        <label name="state"/><field name="state"/>
        <newline/>
        <label name="sub_state"/><field name="sub_state"/>
    </group>

    <newline/>
    <notebook colspan="6">
        <page string="Detail" id="page_detail" col="6">
            <label name="company"/><field name="company"/>
            <label name="property"/><field name="property"/>
            <label name="billing_unit"/><field name="billing_unit"/>
            <newline/>
            <label name="start_date"/><field name="start_date"/>
            <label name="end_date"/><field name="end_date"/>
            <label name="type"/><field name="type"/>
            <newline/>
            <label name="allocation_rule"/><field name="allocation_rule"/>
            <label name="proportional_calculation"/><field name="proportional_calculation"/>            
            <label name="vacancy"/><field name="vacancy"/>
            <newline/>
            <label name="m_type"/><field name="m_type"/>
            <label name="meter_unit"/><field name="meter_unit"/>
            <newline/>
            <label name="planned_costs"/><field name="planned_costs"/>
            <label name="actual_costs"/><field name="actual_costs"/>
            <label name="currency"/><field name="currency"/>
            <newline/>
            <label name="value_total"/><field name="value_total"/>
            <label name="time_total"/><field name="time_total"/>
            <newline/>
            <label name="predecessor"/><field name="predecessor" readonly="1"/>
            <newline/>
            <label name="bved_fuel_data"/><field name="bved_fuel_data" xexpand="0" width="15"/>
            <newline/>
            <separator name="comment" colspan="6"/>
            <field name="comment" colspan="6"/>
        </page>
        <page string="Objects" id="page_objects" col="4">
            <label name="reg_ex_object"/><field name="reg_ex_object" colspan="2"/>
            <newline/>
            <field name="objects" colspan="4"/>
        </page>
        <page string="Measurements" id="page_measurements" col="1">
            <field name="measurements"
                view_ids="real_estate.settlement_unit_measurement_tree"/>
        </page>
        <page string="Meters" id="page_meters" col="4">
            <label name="reg_ex_meter"/><field name="reg_ex_meter" colspan="2"/>
            <newline/>
            <field name="meters" colspan="4"
                view_ids="real_estate.settlement_unit_meter_tree"/>
        </page>
        <page string="Option Rate" id="page_option_rate" col="4">
            <group id="base_object_option_rate" yalign="0">
                <label name="option_rate_method"/><field name="option_rate_method" />
                <newline/>
                <label name="option_measurement_type"/><field name="option_measurement_type"/>
                <newline/>
                <label name="option_rate_value"/><field name="option_rate_value" />
            </group>
            <group id="base_object_option_rate_list">
                <field name="option_rates"
                    view_ids="real_estate.option_rate_view_tree"/>
            </group>
        </page>
        <page string="CO2 Costs" id="page_co2" col="4">
            <label name="co2_kostaufg"/><field name="co2_kostaufg"/>
            <newline/>
            <field name="co2_consumption" colspan="4"
                view_ids="real_estate.co2_kostaufg_consumption_view_list"/>
        </page>
        <page string="B-Satz / Brennstoff" id="page_bved_fuel" col="4">
            <label name="bved_fuel_type"/><field name="bved_fuel_type" colspan="3"/>
            <label name="bved_heating_value"/><field name="bved_heating_value"/>
            <newline/>
            <label name="bved_stock_start_date"/><field name="bved_stock_start_date"/>
            <label name="bved_stock_start_quantity"/><field name="bved_stock_start_quantity"/>
            <newline/>
            <label name="bved_stock_start_amount_gross"/><field name="bved_stock_start_amount_gross"/>
            <label name="bved_stock_start_amount_net"/><field name="bved_stock_start_amount_net"/>
            <newline/>
            <label name="bved_stock_end_date"/><field name="bved_stock_end_date"/>
            <label name="bved_stock_end_quantity"/><field name="bved_stock_end_quantity"/>
            <newline/>
            <label name="bved_stock_end_amount_gross"/><field name="bved_stock_end_amount_gross"/>
            <label name="bved_stock_end_amount_net"/><field name="bved_stock_end_amount_net"/>
            <newline/>
            <label name="bved_ww_temperature"/><field name="bved_ww_temperature"/>
            <label name="bved_ww_consumption_m3"/><field name="bved_ww_consumption_m3"/>
            <newline/>
            <label name="bved_ww_percentage"/><field name="bved_ww_percentage"/>
            <newline/>
            <label name="bved_ww_meter_start"/><field name="bved_ww_meter_start"/>
            <label name="bved_ww_meter_end"/><field name="bved_ww_meter_end"/>
            <newline/>
            <label name="bved_supply_period_heating_1_start"/><field name="bved_supply_period_heating_1_start"/>
            <label name="bved_supply_period_heating_1_end"/><field name="bved_supply_period_heating_1_end"/>
            <newline/>
            <label name="bved_supply_period_heating_2_start"/><field name="bved_supply_period_heating_2_start"/>
            <label name="bved_supply_period_heating_2_end"/><field name="bved_supply_period_heating_2_end"/>
            <newline/>
            <label name="bved_supply_period_ww_1_start"/><field name="bved_supply_period_ww_1_start"/>
            <label name="bved_supply_period_ww_1_end"/><field name="bved_supply_period_ww_1_end"/>
            <newline/>
            <label name="bved_supply_period_ww_2_start"/><field name="bved_supply_period_ww_2_start"/>
            <label name="bved_supply_period_ww_2_end"/><field name="bved_supply_period_ww_2_end"/>
            <newline/>
            <label name="bved_primary_energy_factor"/><field name="bved_primary_energy_factor"/>
        </page>
    </notebook>

    <group colspan="6" id="settlement_unit_base_cost_shares">
        <field name="cost_shares"
            view_ids="real_estate.cost_share_list,real_estate.cost_share_form"
            readonly="1"/>
    </group>

    <group colspan="6" id="settlement_unit_invoice_lines">
        <field name="invoice_lines"
            view_ids="real_estate.invoice_line_view_tree_settlement_unit"
            readonly="1"/>
    </group>

</form>
